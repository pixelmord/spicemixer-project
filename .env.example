# AI features
# Easiest setup — OpenAI cloud (defaults to gpt-4o-mini, supports vision):
OPENAI_API_KEY=sk-...

# Override the model (any chat model on the configured endpoint):
# AI_MODEL=gpt-4o

# For non-OpenAI endpoints, set both AI_BASE_URL and AI_API_KEY.
# Ollama (local):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2-vision

# llama-cpp-python server:
# AI_BASE_URL=http://localhost:8000/v1
# AI_API_KEY=local
# AI_MODEL=<model-name>
