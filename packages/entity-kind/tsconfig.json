{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["es2023"],
    "moduleDetection": "force",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "content-ai": ["../content-ai/src/index.ts"],
      "@pixelmord/content-ai-ingest": ["../content-ai-ingest/src/index.ts"],
      "@pixelmord/content-ai-core/testing": ["../content-ai-core/src/testing/index.ts"],
      "@pixelmord/content-ai-core": ["../content-ai-core/src/index.ts"],
      "recipe-ingestion": ["../recipe-ingestion/src/index.ts"]
    }
  }
}
