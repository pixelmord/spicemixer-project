{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Miso-Butter-Ramen",
  "description": "Eine zehnminütige Pantry-Ramen mit einer glänzenden Miso-Butter-Brühe, weichem Ei und knusprigen Frühlingszwiebeln.",
  "recipeCategory": "Hauptgericht",
  "recipeCuisine": "Japanisch",
  "recipeYield": 2,
  "keywords": [
    "Wochentags",
    "Komfort",
    "schnell",
    "vegetarisch",
    "Pantry",
    "japanisch",
    "schnelles-Ramen-Rezept"
  ],
  "recipeIngredient": [
    "2 Packungen frische Ramen-Nudeln",
    "3 EL weiße Miso-Paste",
    "2 EL ungesalzene Butter",
    "1 EL Sojasauce",
    "1 TL geröstetes Sesamöl",
    "750ml heiße Gemüsebrühe",
    "2 weichgekochte Eier, halbiert",
    "3 Frühlingszwiebeln, dünn geschnitten",
    "1 Blatt Nori, zerrissen"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Miso, Butter, Sojasauce und Sesamöl in die heiße Brühe einrühren, bis sie glatt sind."
    },
    {
      "@type": "HowToStep",
      "text": "Ramen-Nudeln nach Packungsanweisung kochen, abtropfen lassen und auf Schüsseln verteilen."
    },
    {
      "@type": "HowToStep",
      "text": "Brühe über die Nudeln gießen. Mit Eierhälften, Frühlingszwiebeln und Nori toppen."
    },
    {
      "@type": "HowToStep",
      "text": "Sofort essen, während die Butter noch glänzend auf der Brühe ist."
    }
  ],
