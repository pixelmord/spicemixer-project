{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Miso Butter Ramen",
  "recipeIngredient": [
    "2 packs fresh ramen noodles",
    "3 tbsp white miso paste",
    "2 tbsp unsalted butter",
    "1 tbsp soy sauce",
    "1 tsp toasted sesame oil",
    "750ml hot vegetable stock",
    "2 soft-boiled eggs, halved",
    "3 scallions, thinly sliced",
    "1 sheet nori, torn"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Whisk miso, butter, soy and sesame oil into the hot stock until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Cook ramen noodles per package instructions, drain, divide between bowls."
    },
    {
      "@type": "HowToStep",
      "text": "Pour broth over noodles. Top with egg halves, scallions, and nori."
    },
    {
      "@type": "HowToStep",
      "text": "Eat immediately, while the butter is still glossy on the broth."
    }
  ],
  "description": "A ten-minute pantry ramen with a glossy miso-butter broth, soft egg, and crisp scallions.",
