---
import type { RecentEntry } from "../lib/recently-added.ts";

interface Props {
  label: string;
  entries: RecentEntry[];
}
const { label, entries } = Astro.props;
---

<section aria-label={label}>
  <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">{label}</h2>
  {
    entries.length === 0 ? (
      <p class="text-sm text-stone-400">Nothing here yet.</p>
    ) : (
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {entries.map((entry) => (
          <li>
            <a
              href={entry.href}
              class="group flex h-full flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-stone-200 transition hover:shadow-md hover:ring-stone-300"
            >
              <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-400">
                {entry.type}
              </p>
              <p class="mt-1 font-serif text-lg leading-snug text-stone-900">{entry.name}</p>
              {entry.datePublished && (
                <p class="mt-auto pt-3 text-xs text-stone-400">{entry.datePublished}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
