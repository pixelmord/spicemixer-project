---
export interface LightboxStep {
  text: string;
  name?: string;
  image?: string;
  html: string;
}
interface Props {
  steps: LightboxStep[];
}
const { steps } = Astro.props;
const stepsJson = JSON.stringify(steps);
---

<dialog
  id="steps-lightbox"
  class="m-0 h-dvh max-h-none w-dvw max-w-none border-0 bg-transparent p-0 backdrop:bg-stone-950/75 backdrop:backdrop-blur-md"
>
  <!-- centering wrapper — click outside card to close -->
  <div
    id="lightbox-wrap"
    class="flex h-full w-full items-center justify-center p-4 sm:p-8"
  >
    <!-- card -->
    <div
      class="relative flex w-full max-w-md flex-col overflow-hidden rounded-2xl bg-white shadow-2xl"
      style="max-height: min(90vh, 680px);"
    >
      <!-- ── top bar ── -->
      <div class="flex shrink-0 items-center justify-between border-b border-stone-100 px-5 py-3.5">
        <span
          id="lb-counter"
          class="font-serif text-xs font-medium tracking-widest text-amber-600 uppercase"
        ></span>
        <button
          id="lb-close"
          type="button"
          aria-label="Close"
          class="flex h-7 w-7 items-center justify-center rounded-full text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- ── body (animates between steps) ── -->
      <div
        id="lb-body"
        class="flex-1 overflow-y-auto"
        style="transition: opacity 160ms ease, transform 160ms ease;"
      >
        <!-- image or number watermark -->
        <div id="lb-image-wrap" class="hidden">
          <img
            id="lb-image"
            src=""
            alt=""
            class="aspect-video w-full object-cover"
          />
        </div>
        <div id="lb-number-bg" class="hidden select-none overflow-hidden bg-gradient-to-br from-stone-50 to-amber-50/40 px-8 pt-6 pb-0">
          <span
            id="lb-number-display"
            class="block font-serif leading-none text-stone-100"
            style="font-size: clamp(5rem, 20vw, 7rem);"
          ></span>
        </div>

        <!-- text content -->
        <div class="px-6 pt-5 pb-2">
          <p
            id="lb-name"
            class="mb-2 font-serif text-xl leading-snug font-semibold text-stone-900"
          ></p>
          <div
            id="lb-text"
            class="text-[0.9rem] leading-relaxed text-stone-600 [&_a]:text-amber-700 [&_a]:underline [&_a]:decoration-dotted [&_a:hover]:text-amber-900"
          ></div>
        </div>
      </div>

      <!-- ── footer nav ── -->
      <div class="flex shrink-0 items-center justify-between gap-3 border-t border-stone-100 px-3 py-3">
        <button
          id="lb-prev"
          type="button"
          aria-label="Previous step"
          class="flex h-9 w-9 items-center justify-center rounded-full text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700 disabled:pointer-events-none disabled:opacity-30"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>

        <div id="lb-dots" class="flex items-center gap-1.5"></div>

        <button
          id="lb-next"
          type="button"
          aria-label="Next step"
          class="flex h-9 w-9 items-center justify-center rounded-full text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-700 disabled:pointer-events-none disabled:opacity-30"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script define:vars={{ stepsJson }}>
  const steps = JSON.parse(stepsJson);
  const dialog   = document.getElementById("steps-lightbox");
  const wrap     = document.getElementById("lightbox-wrap");
  const body     = document.getElementById("lb-body");
  const counter  = document.getElementById("lb-counter");
  const imageWrap= document.getElementById("lb-image-wrap");
  const image    = document.getElementById("lb-image");
  const numBg    = document.getElementById("lb-number-bg");
  const numDisp  = document.getElementById("lb-number-display");
  const nameEl   = document.getElementById("lb-name");
  const textEl   = document.getElementById("lb-text");
  const dotsEl   = document.getElementById("lb-dots");
  const prevBtn  = document.getElementById("lb-prev");
  const nextBtn  = document.getElementById("lb-next");
  const closeBtn = document.getElementById("lb-close");

  let current = 0;

  // ── build dots once ──────────────────────────────────────────────
  steps.forEach((step, i) => {
    const dot = document.createElement("button");
    dot.type = "button";
    dot.dataset.dotIndex = String(i);
    dot.setAttribute("aria-label", `Step ${i + 1}`);
    dot.style.cssText = "transition: width 200ms ease, background 200ms ease;";
    dotsEl.appendChild(dot);
  });

  function renderDots(idx) {
    Array.from(dotsEl.children).forEach((dot, i) => {
      const hasImg = !!steps[i].image;
      const isCurrent = i === idx;
      if (isCurrent) {
        // active: pill shape, amber
        dot.className = "h-2 rounded-full bg-amber-500 cursor-pointer";
        dot.style.width = "1.5rem";
      } else if (hasImg) {
        // has image: solid small circle, amber-300
        dot.className = "h-2 rounded-full bg-amber-300 cursor-pointer hover:bg-amber-400";
        dot.style.width = "0.5rem";
      } else {
        // text only: ring, stone-300
        dot.className = "h-2 rounded-full ring-1 ring-stone-300 bg-transparent cursor-pointer hover:bg-stone-200";
        dot.style.width = "0.5rem";
      }
    });
  }

  function render(idx, dir) {
    const step = steps[idx];
    const pad = String(idx + 1).padStart(2, "0");

    // counter
    counter.textContent = `Step ${pad} / ${String(steps.length).padStart(2, "0")}`;

    // image vs number watermark
    if (step.image) {
      imageWrap.classList.remove("hidden");
      numBg.classList.add("hidden");
      image.src = step.image;
      image.alt = step.name ?? "";
    } else {
      imageWrap.classList.add("hidden");
      numBg.classList.remove("hidden");
      numDisp.textContent = pad;
    }

    // name
    if (step.name) {
      nameEl.textContent = step.name;
      nameEl.classList.remove("hidden");
    } else {
      nameEl.textContent = "";
      nameEl.classList.add("hidden");
    }

    // text (annotated HTML)
    textEl.innerHTML = step.html;

    // nav buttons
    prevBtn.disabled = idx === 0;
    nextBtn.disabled = idx === steps.length - 1;

    renderDots(idx);
    current = idx;
  }

  function animateTo(idx) {
    if (idx < 0 || idx >= steps.length) return;
    const dir = idx > current ? 1 : -1;

    body.style.opacity = "0";
    body.style.transform = `translateX(${dir * -16}px)`;

    setTimeout(() => {
      render(idx, dir);
      body.style.transform = `translateX(${dir * 16}px)`;
      // force reflow
      void body.offsetWidth;
      body.style.opacity = "1";
      body.style.transform = "translateX(0)";
    }, 160);
  }

  function openAt(idx) {
    render(idx, 0);
    body.style.opacity = "1";
    body.style.transform = "translateX(0)";
    dialog.showModal();
  }

  // ── event listeners ──────────────────────────────────────────────

  // open from thumbnail buttons (delegated)
  document.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-lightbox-step]");
    if (!btn) return;
    openAt(parseInt(btn.dataset.lightboxStep, 10));
  });

  // dot navigation
  dotsEl.addEventListener("click", (e) => {
    const dot = e.target.closest("[data-dot-index]");
    if (!dot) return;
    const idx = parseInt(dot.dataset.dotIndex, 10);
    if (idx !== current) animateTo(idx);
  });

  prevBtn.addEventListener("click", () => animateTo(current - 1));
  nextBtn.addEventListener("click", () => animateTo(current + 1));
  closeBtn.addEventListener("click", () => dialog.close());

  // backdrop click closes
  wrap.addEventListener("click", (e) => {
    if (e.target === wrap) dialog.close();
  });

  // keyboard
  dialog.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); animateTo(current - 1); }
    if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); animateTo(current + 1); }
  });
</script>
