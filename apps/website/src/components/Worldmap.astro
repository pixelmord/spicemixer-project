---
import { REGIONS, REGION_LABELS, DOT_POSITIONS, type RegionCode } from "../lib/regions.ts";
import type { RegionCount } from "../lib/region-aggregation.ts";

interface Props {
  aggregation: Map<RegionCode, RegionCount>;
  locale?: string;
  class?: string;
}

const { aggregation, locale, class: className } = Astro.props;
const prefix = locale === "de" ? "/de" : "";
const lang = (locale ?? "en") as "en" | "de";
const plannedLabel = lang === "de" ? "Geplant" : "Planned";

type DotData = {
  code: RegionCode;
  label: string;
  x: number;
  y: number;
  filled: boolean;
  href: string;
  tooltip: string;
};

const dots: DotData[] = REGIONS.map((code) => {
  const counts = aggregation.get(code) ?? { mixtures: 0, ingredients: 0, recipes: 0 };
  const total = counts.mixtures + counts.ingredients + counts.recipes;
  const filled = total >= 1;
  const label = REGION_LABELS[code][lang];
  const tooltip = filled
    ? `${label} · ${counts.mixtures} mixtures · ${counts.ingredients} ingredients · ${counts.recipes} recipes`
    : plannedLabel;
  return {
    code,
    label,
    x: DOT_POSITIONS[code].x,
    y: DOT_POSITIONS[code].y,
    filled,
    href: `${prefix}/ingredients/?region=${code}`,
    tooltip,
  };
});
---

<section class:list={["worldmap-section mb-12", className]} aria-label="Worldmap">
  <div class="relative w-full overflow-hidden rounded-2xl bg-stone-100 ring-1 ring-stone-200">
    <svg
      viewBox="0 0 100 75"
      xmlns="http://www.w3.org/2000/svg"
      class="w-full"
      aria-label="Culinary regions worldmap"
      role="img"
    >
      <!-- Abstract world canvas background -->
      <rect width="100" height="75" fill="#f5f5f4" />
      <!-- Stylised continental outlines (abstract, not geographic) -->
      <rect x="5" y="10" width="28" height="45" rx="4" fill="#e7e5e4" opacity="0.6" />
      <rect x="38" y="8" width="24" height="50" rx="4" fill="#e7e5e4" opacity="0.6" />
      <rect x="60" y="10" width="28" height="45" rx="4" fill="#e7e5e4" opacity="0.6" />

      {
        dots.map((dot) =>
          dot.filled ? (
            <a href={dot.href} aria-label={dot.tooltip}>
              <circle
                cx={dot.x}
                cy={dot.y}
                r="2"
                fill="#b45309"
                class="cursor-pointer transition-transform hover:scale-125"
              >
                <title>{dot.tooltip}</title>
              </circle>
            </a>
          ) : (
            <circle
              cx={dot.x}
              cy={dot.y}
              r="2"
              fill="none"
              stroke="#a8a29e"
              stroke-width="0.5"
              aria-label={`${dot.label} · ${plannedLabel}`}
            >
              <title>{`${dot.label} · ${plannedLabel}`}</title>
            </circle>
          )
        )
      }
    </svg>
  </div>
</section>
