---
import WorldmapHero from "./WorldmapHero.tsx";
import type { ResolvedDot } from "../lib/worldmap-placement.ts";

interface Props {
  dots: ResolvedDot[];
  cols: number;
  rows: number;
  prefix: string;
  lang: "en" | "de";
  labels: { moreRecipes: string; moreMixtures: string };
  heading?: string;
  class?: string;
}

const { dots, cols, rows, prefix, lang, labels, heading, class: className } = Astro.props;
---

<section class:list={["worldmap-section mb-12", className]} aria-label="Worldmap">
  {
    heading && (
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">{heading}</p>
    )
  }
  <div class="overflow-visible rounded-2xl bg-stone-50 p-4 ring-1 ring-stone-200 sm:p-8">
    <WorldmapHero dots={dots} cols={cols} rows={rows} prefix={prefix} lang={lang} labels={labels} />
  </div>
</section>

<style is:global>
  .worldmap-grid {
    overflow: visible;
  }
  .worldmap-dot {
    margin: auto;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 9999px;
  }
  .worldmap-dot--empty {
    background: transparent;
    border: 1.5px solid var(--dot-color);
    opacity: 0.32;
  }
  .worldmap-dot--filled {
    position: relative;
    width: 70%;
  }
  .worldmap-dot__hit {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--dot-color);
    transition:
      transform 0.16s ease-out,
      box-shadow 0.16s ease-out;
    cursor: pointer;
  }
  .worldmap-dot--filled:hover .worldmap-dot__hit,
  .worldmap-dot--filled:focus-within .worldmap-dot__hit {
    transform: scale(1.45);
    box-shadow: 0 0 6px var(--dot-color);
  }
  @media (prefers-reduced-motion: reduce) {
    .worldmap-dot__hit {
      transition: none;
    }
  }

  .worldmap-popover {
    position: absolute;
    z-index: 50;
    width: 232px;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #fffdf8;
    border: 1px solid #c8bba8;
    box-shadow: 0 8px 32px rgba(28, 22, 16, 0.16);
    opacity: 0;
    transform: scale(0.96);
    pointer-events: none;
    transition:
      opacity 0.14s ease-out,
      transform 0.14s ease-out;
  }
  /* Horizontal anchor: centered uses margin-left so transform stays scale-only. */
  .worldmap-popover[data-halign="center"] {
    left: 50%;
    margin-left: -116px;
    transform-origin: top center;
  }
  .worldmap-popover[data-halign="start"] {
    left: 0;
    transform-origin: top left;
  }
  .worldmap-popover[data-halign="end"] {
    right: 0;
    transform-origin: top right;
  }
  /* Vertical anchor. */
  .worldmap-popover[data-valign="below"] {
    top: 150%;
  }
  .worldmap-popover[data-valign="above"] {
    bottom: 150%;
    transform-origin: bottom center;
  }
  .worldmap-popover[data-valign="above"][data-halign="start"] {
    transform-origin: bottom left;
  }
  .worldmap-popover[data-valign="above"][data-halign="end"] {
    transform-origin: bottom right;
  }
  .worldmap-dot--filled:hover .worldmap-popover,
  .worldmap-dot--filled:focus-within .worldmap-popover {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .worldmap-popover__img {
    height: 6rem;
    width: 100%;
    object-fit: cover;
  }
  .worldmap-popover__body {
    padding: 0.875rem 1rem 1rem;
  }
  .worldmap-popover__tag {
    display: inline-block;
    margin-bottom: 0.5rem;
    border-radius: 9999px;
    padding: 0.1rem 0.5rem;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
  }
  .worldmap-popover__title {
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: 1.05rem;
    line-height: 1.2;
    color: #1c1610;
  }
  .worldmap-popover__desc {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #6b5d4f;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .worldmap-popover__link {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b5470b;
  }
  .worldmap-popover__link:hover {
    text-decoration: underline;
  }
  .worldmap-popover__link--muted {
    margin-top: 0.3rem;
    font-weight: 500;
    color: #6b5d4f;
  }

  .worldmap-legend {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }
  .worldmap-legend__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .worldmap-legend__swatch {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
  }
  .worldmap-legend__label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #6b5d4f;
  }
</style>
