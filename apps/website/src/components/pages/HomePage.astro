---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Worldmap from "../Worldmap.astro";
import FeaturedPairingBlock from "../FeaturedPairingBlock.astro";
import RecentlyAddedFeed from "../RecentlyAddedFeed.astro";
import { getPublished, getPublishedIngredients, getPublishedPairings, slugFromLocaleId } from "../../lib/recipe-augment.ts";
import { recentlyAdded, type RecentEntry } from "../../lib/recently-added.ts";
import { FEATURED_PAIRING_SLUG } from "../../lib/homepage.config.ts";
import { regionAggregation, type AggregationEntry } from "../../lib/region-aggregation.ts";
import { getCollection } from "astro:content";
import { useTranslations, type Lang } from "../../i18n/translations.ts";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";

const [mixtures, rawIngredients, pairings, allIngredientsMeta, allMeta] = await Promise.all([
  getPublished("mixtures"),
  getPublishedIngredients(locale),
  getPublishedPairings(locale),
  getCollection("ingredientMeta"),
  getCollection("meta"),
]);
const draftSlugs = new Set(
  (allIngredientsMeta as Array<{ id: string; data: { draft?: boolean } }>)
    .filter((m) => m.data.draft === true)
    .map((m) => m.id),
);
const ingredients = (rawIngredients as Array<{ id: string; data: { name: string } }>).filter(
  (e) => !draftSlugs.has(e.id),
);

// Build aggregation entries for the worldmap (locale-scoped to avoid double-counting)
const ingredientAggEntries: AggregationEntry[] = (
  rawIngredients as Array<{ id: string; data: { region?: string[] } }>
)
  .filter((e) => !draftSlugs.has(e.id))
  .map((e) => ({ type: "ingredient", region: e.data.region ?? [] }));

const metaAggEntries: AggregationEntry[] = (
  allMeta as Array<{ id: string; data: { draft?: boolean; region?: string[] } }>
)
  .filter((m) => {
    const parts = m.id.split("/");
    return parts[1] === locale && m.data.draft !== true;
  })
  .map((m) => ({
    type: m.id.startsWith("mixtures/") ? ("mixture" as const) : ("recipe" as const),
    region: m.data.region ?? [],
  }));

const aggregation = regionAggregation([...ingredientAggEntries, ...metaAggEntries]);

const mixtureEntries: RecentEntry[] = mixtures.map((e) => {
  const slug = slugFromLocaleId(e.id);
  return {
    type: "mixture",
    slug,
    name: (e.data as { name: string }).name,
    href: `${prefix}/mixtures/${slug}/`,
    datePublished: (e.data as { datePublished?: string }).datePublished,
  };
});

const ingredientEntries: RecentEntry[] = ingredients.map((e) => {
  const slug = e.id.replace(/^[a-z]{2}\//, "");
  return {
    type: "ingredient",
    slug,
    name: e.data.name,
    href: `${prefix}/ingredients/${slug}/`,
  };
});

const pairingEntries: RecentEntry[] = pairings.map((p) => ({
  type: "pairing",
  slug: p.id,
  name: `${p.endpoints[0].slug} & ${p.endpoints[1].slug}`,
  href: `${prefix}/pairings/${p.id}/`,
}));

const feedEntries = recentlyAdded([...mixtureEntries, ...ingredientEntries, ...pairingEntries], {
  excludeRecipes: true,
  limit: 12,
});

const featuredPairing = pairings.find((p) => p.id === FEATURED_PAIRING_SLUG) ?? pairings[0];
---

<BaseLayout title={t("page.home.title")} description={t("page.home.description")}>
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">Spicemixer</p>
      <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900 sm:text-6xl">
        {t("page.home.tagline")}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-stone-600">{t("page.home.description")}</p>
    </header>

    <Worldmap aggregation={aggregation} locale={locale} />

    {
      featuredPairing && (
        <FeaturedPairingBlock
          label={t("page.home.featuredPairing")}
          ingredientA={featuredPairing.endpoints[0].slug}
          ingredientB={featuredPairing.endpoints[1].slug}
          description={featuredPairing.description}
          href={`${prefix}/pairings/${featuredPairing.id}/`}
        />
      )
    }

    <RecentlyAddedFeed label={t("page.home.recentlyAdded")} entries={feedEntries} />
  </main>
</BaseLayout>
