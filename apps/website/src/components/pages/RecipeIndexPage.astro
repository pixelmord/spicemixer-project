---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterBar from "../FilterBar.astro";
import RecipeCard from "../RecipeCard.astro";
import { keywordList } from "../../lib/instructions.ts";
import { getPublished } from "../../lib/recipe-augment.ts";
import { useTranslations, type Lang } from "../../i18n/translations.ts";

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const recipes = (await getPublished("recipes")).sort((a, b) => {
  const da = a.data.datePublished ?? "";
  const db = b.data.datePublished ?? "";
  return db.localeCompare(da);
});

const categories = [...new Set(recipes.map((r) => r.data.recipeCategory).filter((c): c is string => Boolean(c)))].sort();
const cuisines = [...new Set(recipes.map((r) => r.data.recipeCuisine).filter((c): c is string => Boolean(c)))].sort();
const tags = [...new Set(recipes.flatMap((r) => keywordList(r.data.keywords)))].sort();

const groups = [
  { key: "category", label: t("filter.category"), values: categories.map((v) => ({ value: v, label: v })) },
  { key: "cuisine", label: t("filter.cuisine"), values: cuisines.map((v) => ({ value: v, label: v })) },
  { key: "tags", label: t("filter.tag"), values: tags.map((v) => ({ value: v, label: v })) },
];

const countSuffix = t("filter.count").replace("{total}", String(recipes.length));
---

<BaseLayout title={t("page.recipes.title")} description={t("page.recipes.description")}>
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">Spicemixer</p>
      <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900 sm:text-6xl">
        {t("page.recipes.tagline")}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-stone-600">{t("page.recipes.description")}</p>
    </header>

    <FilterBar groups={groups} totalCount={recipes.length} countSuffix={countSuffix} />

    <section class="columns-1 gap-6 sm:columns-2 lg:columns-3 xl:columns-4">
      {recipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </section>

    <p data-empty-state hidden class="mt-16 text-center text-stone-500">
      {t("filter.empty")}
    </p>
  </main>
</BaseLayout>
