---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DetailLayout from "../DetailLayout.astro";
import RelatedList from "../RelatedList.astro";
import TranslationFallbackBanner from "../TranslationFallbackBanner.astro";
import { useTranslations, type Lang } from "../../i18n/translations.ts";
import IngredientTaxonomy from "../IngredientTaxonomy.astro";
import { getUsedIn, getIngredient, getPairings } from "../../lib/recipe-augment.ts";
import { withPagefindFilters } from "../../lib/withPagefindFilters.ts";
import { renderInlineMarkdown } from "../../lib/inline-markdown.ts";
import { INGREDIENT_LONGFORM_FIELDS } from "../../lib/ingredient-schema.ts";
import { hasLiabilityScope } from "../../lib/liability.ts";
import { hreflangTags } from "../../lib/hreflang.ts";

interface Props {
  ingredient: CollectionEntry<"ingredients">;
  isFallback: boolean;
  canonicalLocale: string;
}

const { ingredient, isFallback, canonicalLocale } = Astro.props;
const data = ingredient.data;
const slug = Astro.params.slug as string;

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
const prefix = locale === "de" ? "/de" : "";

const SECTION_LABELS: Record<(typeof INGREDIENT_LONGFORM_FIELDS)[number], string> = {
  culinaryUse: t("ingredient.section.culinaryUse"),
  medicinalUses: t("ingredient.section.medicinalUses"),
  healthBenefits: t("ingredient.section.healthBenefits"),
  safetyNotes: t("ingredient.section.safetyNotes"),
  history: t("ingredient.section.history"),
  storage: t("ingredient.section.storage"),
  sourcing: t("ingredient.section.sourcing"),
};

const pagefindFilters = withPagefindFilters({
  category: data.category,
  flavorProfile: data.flavorProfile,
  region: data.region,
});

const usedIn = await getUsedIn(slug, prefix);

const pairingEntities = await getPairings(slug);
const pairingsResolved = pairingEntities.length > 0
  ? await Promise.all(
      pairingEntities.map(async (pairing) => {
        const otherSlug = pairing.ingredients[0] === slug ? pairing.ingredients[1] : pairing.ingredients[0];
        const entry = await getIngredient(otherSlug, locale);
        const descriptions = pairing.descriptions ?? {};
        const description = descriptions[locale] ?? descriptions["en"] ?? pairing.description ?? "";
        const pairingFallback = !descriptions[locale] && (!!descriptions["en"] || !!pairing.description);
        return { slug: otherSlug, name: entry?.data.name ?? otherSlug, description, isFallback: pairingFallback };
      })
    )
  : await Promise.all(
      (data.pairings ?? []).map(async ({ slug: pairSlug, note }) => {
        const entry = await getIngredient(pairSlug, locale);
        return { slug: pairSlug, name: entry?.data.name ?? pairSlug, description: note ?? "", isFallback: false };
      })
    );

const hreflang = await hreflangTags(slug, "ingredients", Astro.site?.toString().replace(/\/$/, "") ?? "");
---

<BaseLayout title={`${data.name} — Spicemixer`} description={data.summary}>
  <Fragment slot="head">
    {hreflang.map((tag) => (
      <link rel="alternate" hreflang={tag.hrefLang} href={tag.href} />
    ))}
  </Fragment>

  <main
    class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8"
    data-pagefind-body
  >
    {Object.entries(pagefindFilters).map(([key, value]) => (
      <span data-pagefind-filter={`${key}:${value}`} hidden aria-hidden="true" />
    ))}
    <nav class="mb-8 flex items-center justify-between text-sm">
      <a
        href={`${prefix}/ingredients/`}
        class="text-stone-500 transition hover:text-stone-900"
      >
        {t("nav.back.ingredients")}
      </a>
      <a
        href={`/admin/ingredients/${slug}/edit`}
        data-admin-link
        class="hidden text-xs text-stone-400 transition hover:text-stone-700"
      >
        Edit
      </a>
    </nav>

    {isFallback && (
      <TranslationFallbackBanner requestedLocale={locale} canonicalLocale={canonicalLocale} />
    )}

    <DetailLayout>
      <section slot="hero">
        {
          data.images[0] ? (
            <figure class="mb-8 overflow-hidden rounded-3xl">
              <img
                src={data.images[0]}
                alt={data.name}
                class="aspect-[16/9] w-full object-cover"
              />
            </figure>
          ) : (
            <div class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-rose-50 p-10">
              <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
                {data.category}
              </p>
              <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">
                {data.name}
              </h1>
            </div>
          )
        }

        {
          data.images[0] && (
            <header class="mb-6">
              <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
                {data.category}
              </p>
              <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">
                {data.name}
              </h1>
            </header>
          )
        }

        {data.summary && (
          <p class="mb-6 text-lg italic text-stone-700">{data.summary}</p>
        )}
      </section>

      <section slot="encyclopedia">
        <IngredientTaxonomy data={data} t={t} />

        {
          data.description && (
            <section class="mb-10">
              <p class="leading-relaxed text-stone-800" set:html={renderInlineMarkdown(data.description)} />
            </section>
          )
        }

        {
          INGREDIENT_LONGFORM_FIELDS.map((field) => {
            const text = data[field];
            if (!text) return null;
            return (
              <section class="mb-10">
                <h2 class="mb-3 font-serif text-2xl text-stone-900">{SECTION_LABELS[field]}</h2>
                <div class="leading-relaxed text-stone-800" set:html={renderInlineMarkdown(text)} />
              </section>
            );
          })
        }

        {
          data.images.length > 1 && (
            <section class="mb-10">
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                {data.images.slice(1).map((src) => (
                  <figure class="overflow-hidden rounded-2xl">
                    <img
                      src={src}
                      alt={data.name}
                      class="aspect-square w-full object-cover"
                    />
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          data.sources && data.sources.length > 0 && (
            <section class="mb-10">
              <h2 class="mb-3 font-serif text-2xl text-stone-900">{t("ingredient.sources")}</h2>
              <ol class="list-decimal pl-5 space-y-1 text-sm text-stone-700">
                {data.sources.map((src) => (
                  <li>
                    <a
                      href={src.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-amber-700 underline decoration-dotted underline-offset-2 hover:text-amber-900"
                    >
                      {src.title}
                    </a>
                    {src.author && <span class="text-stone-500"> — {src.author}</span>}
                    {src.year && <span class="text-stone-500"> ({src.year})</span>}
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </section>

      <section slot="relations">
        {
          pairingsResolved.length > 0 && (
            <section class="mb-10">
              <h2 class="mb-4 font-serif text-2xl text-stone-900">
                {t("section.pairings")}
              </h2>
              <ul class="space-y-3">
                {pairingsResolved.map(({ slug: pairSlug, name, description, isFallback: pairingFallback }) => (
                  <li class="rounded-xl bg-white p-4 ring-1 ring-stone-200">
                    <a
                      href={`${prefix}/ingredients/${pairSlug}/`}
                      class="font-medium text-amber-700 underline decoration-dotted underline-offset-2 hover:text-amber-900"
                    >
                      {name}
                    </a>
                    {description && (
                      <p class={`mt-1 text-sm ${pairingFallback ? "text-stone-400 italic" : "text-stone-600"}`}>
                        {description}
                        {pairingFallback && <span class="ml-1 text-xs not-italic">(EN)</span>}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <RelatedList heading={t("section.usedIn")} items={usedIn} />
      </section>

      {hasLiabilityScope(data) && (
        <p slot="liability" class="mb-8 text-xs text-stone-500 italic border-t border-stone-100 pt-4">
          {t("ingredient.liability")}
        </p>
      )}
    </DetailLayout>
  </main>
</BaseLayout>
