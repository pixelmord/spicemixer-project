---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getIngredient, getPublishedPairings } from "../../lib/recipe-augment.ts";
import { withPagefindFilters } from "../../lib/withPagefindFilters.ts";
import { useTranslations, type Lang } from "../../i18n/translations.ts";

type Pairing = Awaited<ReturnType<typeof getPublishedPairings>>[number];

interface Props {
  pairing: Pairing;
}

const { pairing } = Astro.props;
const locale = Astro.currentLocale as Lang;
const prefix = locale === "de" ? "/de" : "";
const t = useTranslations(locale);

const [aEntry, bEntry] = await Promise.all([
  getIngredient(pairing.endpoints[0].slug, locale),
  getIngredient(pairing.endpoints[1].slug, locale),
]);
const aName = aEntry?.data.name ?? pairing.endpoints[0].slug;
const bName = bEntry?.data.name ?? pairing.endpoints[1].slug;

const pagefindFilters = withPagefindFilters({ region: pairing.regions });
---

<BaseLayout
  title={`${aName} & ${bName} — Spicemixer`}
  description={pairing.description || undefined}
>
  <main
    class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8"
    data-pagefind-body
  >
    {Object.entries(pagefindFilters).map(([key, value]) => (
      <span data-pagefind-filter={`${key}:${value}`} hidden aria-hidden="true" />
    ))}

    <nav class="mb-8 text-sm">
      <a href={`${prefix}/pairings/`} class="text-stone-500 transition hover:text-stone-900">
        ← {t("nav.pairings")}
      </a>
    </nav>

    <header class="mb-8">
      <h1 class="font-serif text-5xl leading-tight text-stone-900">
        {aName} & {bName}
      </h1>
      {pairing.description && (
        <p class="mt-4 text-lg italic text-stone-700">{pairing.description}</p>
      )}
    </header>

    <section class="mb-10 flex flex-wrap gap-4">
      <a
        href={`${prefix}/ingredients/${pairing.endpoints[0].slug}/`}
        class="rounded-full bg-amber-100 px-5 py-2.5 text-sm font-medium text-amber-800 transition hover:bg-amber-200"
      >
        {aName}
      </a>
      <a
        href={`${prefix}/ingredients/${pairing.endpoints[1].slug}/`}
        class="rounded-full bg-amber-100 px-5 py-2.5 text-sm font-medium text-amber-800 transition hover:bg-amber-200"
      >
        {bName}
      </a>
    </section>
  </main>
</BaseLayout>
