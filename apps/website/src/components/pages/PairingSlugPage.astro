---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TranslationFallbackBanner from "../TranslationFallbackBanner.astro";
import { withPagefindFilters } from "../../lib/withPagefindFilters.ts";
import { useTranslations, type Lang } from "../../i18n/translations.ts";
import type { PublishedPairing } from "../../lib/recipe-augment.ts";

interface Props {
  pairing: PublishedPairing;
  isFallback: boolean;
  canonicalLocale: string;
}

const { pairing, isFallback, canonicalLocale } = Astro.props;
const locale = Astro.currentLocale as Lang;
const prefix = locale === "de" ? "/de" : "";
const t = useTranslations(locale);

async function resolveEndpointName(
  collection: string,
  slug: string,
  loc: string,
): Promise<string | null> {
  const entry =
    (await getEntry(collection as "ingredients" | "mixtures" | "recipes", `${loc}/${slug}`)) ??
    (await getEntry(collection as "ingredients" | "mixtures" | "recipes", `en/${slug}`));
  return entry ? (entry.data as { name: string }).name : null;
}

const [aName, bName] = await Promise.all([
  resolveEndpointName(pairing.endpoints[0].collection, pairing.endpoints[0].slug, locale),
  resolveEndpointName(pairing.endpoints[1].collection, pairing.endpoints[1].slug, locale),
]);
const aDisplayName = aName ?? pairing.endpoints[0].slug;
const bDisplayName = bName ?? pairing.endpoints[1].slug;
const aHref = `${prefix}/${pairing.endpoints[0].collection}/${pairing.endpoints[0].slug}/`;
const bHref = `${prefix}/${pairing.endpoints[1].collection}/${pairing.endpoints[1].slug}/`;

const pagefindFilters = withPagefindFilters({ region: pairing.regions });
---

<BaseLayout
  title={`${aDisplayName} & ${bDisplayName} — Spicemixer`}
  description={pairing.description || undefined}
>
  <main
    class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8"
    data-pagefind-body
  >
    {Object.entries(pagefindFilters).map(([key, value]) => (
      <span data-pagefind-filter={`${key}:${value}`} hidden aria-hidden="true" />
    ))}

    <nav class="mb-8 text-sm">
      <a href={`${prefix}/pairings/`} class="text-stone-500 transition hover:text-stone-900">
        ← {t("nav.pairings")}
      </a>
    </nav>

    {isFallback && (
      <TranslationFallbackBanner requestedLocale={locale} canonicalLocale={canonicalLocale} />
    )}

    <header class="mb-8">
      <h1 class="font-serif text-5xl leading-tight text-stone-900">
        {aDisplayName} & {bDisplayName}
      </h1>
      {pairing.description && (
        <p class="mt-4 text-lg italic text-stone-700">{pairing.description}</p>
      )}
    </header>

    <section class="mb-10 flex flex-wrap gap-4">
      <a
        href={aHref}
        class="rounded-full bg-amber-100 px-5 py-2.5 text-sm font-medium text-amber-800 transition hover:bg-amber-200"
      >
        {aDisplayName}
      </a>
      <a
        href={bHref}
        class="rounded-full bg-amber-100 px-5 py-2.5 text-sm font-medium text-amber-800 transition hover:bg-amber-200"
      >
        {bDisplayName}
      </a>
    </section>
  </main>
</BaseLayout>
