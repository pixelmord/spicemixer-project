---
import { useTranslations, type Lang } from "../i18n/translations.ts";

export interface FilterGroup {
  /** URL param key; also used to derive the data-filter-{key} attribute on cards. */
  key: string;
  label: string;
  values: Array<{ value: string; label: string }>;
}

interface Props {
  groups: FilterGroup[];
  totalCount: number;
  /** Optional suffix after the visible-count number, e.g. "of 24 recipes". */
  countSuffix?: string;
}

const { groups, totalCount, countSuffix } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? "en") as Lang);
---

<aside
  data-filter-bar
  class="sticky top-0 z-10 -mx-4 mb-8 border-b border-stone-200 bg-stone-50/85 px-4 py-4 backdrop-blur sm:mx-0 sm:rounded-2xl sm:border sm:px-5"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm text-stone-600">
      <span data-result-count>{totalCount}</span>
      {countSuffix && <>{" "}{countSuffix}</>}
    </p>
    <button
      type="button"
      data-clear-filters
      class="rounded-full bg-stone-900 px-3 py-1 text-xs font-medium text-white opacity-0 transition data-[active=true]:opacity-100"
    >
      {t("filter.clear")}
    </button>
  </div>

  <div class="mt-3 space-y-2">
    {
      groups.map((group) =>
        group.values.length > 0 ? (
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-400">
              {group.label}
            </span>
            <ul class="flex flex-wrap gap-1.5">
              {group.values.map(({ value, label }) => (
                <li>
                  <button
                    type="button"
                    data-filter-type={group.key}
                    data-filter-value={value}
                    aria-pressed="false"
                    class="rounded-full border border-stone-200 bg-white px-3 py-1 text-xs text-stone-700 transition hover:border-stone-400 aria-[pressed=true]:border-stone-900 aria-[pressed=true]:bg-stone-900 aria-[pressed=true]:text-white"
                  >
                    {label}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ) : null,
      )
    }
  </div>
</aside>

<script>
  import "../scripts/filter-bar.ts";
</script>
