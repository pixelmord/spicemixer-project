---
import { useTranslations, type Lang } from "../i18n/translations.ts";

interface Props {
  tags: string[];
  categories: string[];
  cuisines: string[];
  totalCount: number;
}

const { tags, categories, cuisines, totalCount } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? "en") as Lang);

const countSuffix = t("filter.count").replace("{total}", String(totalCount));

const sections = [
  { type: "category", label: t("filter.category"), values: categories },
  { type: "cuisine", label: t("filter.cuisine"), values: cuisines },
  { type: "tag", label: t("filter.tag"), values: tags },
] as const;
---

<aside
  data-filter-bar
  class="sticky top-0 z-10 -mx-4 mb-8 border-b border-stone-200 bg-stone-50/85 px-4 py-4 backdrop-blur sm:mx-0 sm:rounded-2xl sm:border sm:px-5"
>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-sm text-stone-600">
      <span data-result-count>{totalCount}</span>
      {" "}{countSuffix}
    </p>
    <button
      type="button"
      data-clear-filters
      class="rounded-full bg-stone-900 px-3 py-1 text-xs font-medium text-white opacity-0 transition data-[active=true]:opacity-100"
    >
      {t("filter.clear")}
    </button>
  </div>

  <div class="mt-3 space-y-2">
    {
      sections.map((section) =>
        section.values.length > 0 ? (
          <div class="flex flex-wrap items-baseline gap-2">
            <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-400">
              {section.label}
            </span>
            <ul class="flex flex-wrap gap-1.5">
              {section.values.map((value) => (
                <li>
                  <button
                    type="button"
                    data-filter-type={section.type}
                    data-filter-value={value}
                    aria-pressed="false"
                    class="rounded-full border border-stone-200 bg-white px-3 py-1 text-xs text-stone-700 transition hover:border-stone-400 aria-[pressed=true]:border-stone-900 aria-[pressed=true]:bg-stone-900 aria-[pressed=true]:text-white"
                  >
                    {value}
                  </button>
                </li>
              ))}
            </ul>
          </div>
        ) : null,
      )
    }
  </div>
</aside>
