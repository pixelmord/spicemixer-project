---
interface Props {
  heading: string;
  sources: Array<{ url: string; title: string; source?: string }>;
}

const { heading, sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="mb-10">
      <h2 class="mb-3 font-serif text-2xl text-stone-900">{heading}</h2>
      <ul class="space-y-3">
        {sources.map(({ url, title, source }) => (
          <li>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-start gap-3"
            >
              <span class="text-stone-800 underline decoration-dotted underline-offset-2 group-hover:text-stone-900">
                {title}
              </span>
              {source && (
                <span class="mt-0.5 shrink-0 text-xs text-stone-400 group-hover:text-stone-500">
                  ↗ {source}
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
