---
import { type CollectionEntry } from "astro:content";
import MixtureSlugPage from "../../components/pages/MixtureSlugPage.astro";
import { mixtureSlugPaths } from "../../lib/static-paths/mixture-slug-paths.ts";
import type { MixtureKind } from "../../lib/mixture-schema.ts";

export const getStaticPaths = () => mixtureSlugPaths("en");

interface Props {
  mix: CollectionEntry<"mixtures"> | null;
  kind: MixtureKind | null;
  kindMixtures: CollectionEntry<"mixtures">[] | null;
  isFallback: boolean;
  canonicalLocale: string;
}
---
<MixtureSlugPage {...Astro.props} />
