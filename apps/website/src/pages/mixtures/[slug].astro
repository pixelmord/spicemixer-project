---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterBar from "../../components/FilterBar.astro";
import DetailLayout from "../../components/DetailLayout.astro";
import RecipeMeta from "../../components/RecipeMeta.astro";
import RelatedList from "../../components/RelatedList.astro";
import ExternalSourceList from "../../components/ExternalSourceList.astro";
import { firstImage, keywordList, normalizeInstructions } from "../../lib/instructions.ts";
import StepImage from "../../components/StepImage.astro";
import StepsLightbox from "../../components/StepsLightbox.astro";
import {
  getMeta,
  getPublished,
  linkIngredients,
  annotateTextHtml,
  resolveRefs,
  resolveVariants,
  type Meta,
} from "../../lib/recipe-augment.ts";
import { MIXTURE_KINDS, MIXTURE_KIND_PLURALS, buildKindBySlug, type MixtureKind } from "../../lib/mixture-schema.ts";
import { useTranslations, type Lang } from "../../i18n/translations.ts";

export async function getStaticPaths() {
  const allMixtures = await getPublished("mixtures");
  const rawMeta = await getCollection("meta");

  const kindBySlug = buildKindBySlug(rawMeta);

  const kindPaths = MIXTURE_KINDS.map((kind) => ({
    params: { slug: MIXTURE_KIND_PLURALS[kind] },
    props: {
      kind,
      kindMixtures: allMixtures.filter((m) => kindBySlug.get(m.id) === kind),
      mix: null as CollectionEntry<"mixtures"> | null,
    },
  }));

  const detailPaths = allMixtures.map((mix) => ({
    params: { slug: mix.id },
    props: {
      kind: null as MixtureKind | null,
      kindMixtures: null as CollectionEntry<"mixtures">[] | null,
      mix,
    },
  }));

  return [...kindPaths, ...detailPaths];
}

interface Props {
  mix: CollectionEntry<"mixtures"> | null;
  kind: MixtureKind | null;
  kindMixtures: CollectionEntry<"mixtures">[] | null;
}

const { mix, kind, kindMixtures } = Astro.props;
const t = useTranslations((Astro.currentLocale ?? "en") as Lang);
const locale = Astro.currentLocale ?? "en";
const prefix = locale === "de" ? "/de" : "";
const ingredientBase = `${prefix}/ingredients`;

let detailImage: string | undefined;
let detailTags: string[] = [];
let detailSteps: ReturnType<typeof normalizeInstructions> = [];
let transitionName = "";
let jsonLd = "";
let meta: Meta | null = null;
let linkedIngredients: ReturnType<typeof linkIngredients> = [];
let goesWellWithItems: { name: string; href: string }[] = [];
let usesBaseItems: { name: string; href: string }[] = [];
let variantItems: { name: string; href: string }[] = [];
let variantOfItem: { name: string; href: string } | null = null;
let lightboxSteps: { name?: string; text: string; image?: string; html: string }[] = [];
let kindBadgeLabel = "";

if (mix) {
  const data = mix.data;
  const slug = mix.id;

  detailImage = firstImage(data.image);
  detailTags = keywordList(data.keywords);
  detailSteps = normalizeInstructions(data.recipeInstructions);
  transitionName = `mixture-${slug}`;
  jsonLd = JSON.stringify(data);

  meta = await getMeta("mixtures", slug);
  linkedIngredients = linkIngredients(data.recipeIngredient, meta.ingredientLinks);

  if (meta.kind && meta.kind !== "recipe") {
    kindBadgeLabel = t(`kind.${meta.kind as MixtureKind}`);
  }

  [goesWellWithItems, usesBaseItems, variantItems] = await Promise.all([
    resolveRefs(meta.goesWellWith, prefix),
    resolveRefs(meta.usesBase, prefix),
    resolveVariants("mixtures", meta.variants, prefix),
  ]);

  if (meta.variantOf) {
    const [item] = await resolveVariants("mixtures", [meta.variantOf], prefix);
    variantOfItem = item ?? null;
  }

  lightboxSteps = detailSteps.map((step) => ({
    ...step,
    html: annotateTextHtml(step.text, meta!.ingredientLinks, ingredientBase),
  }));
}

const kindLabel = kind ? t(`kind.${kind}`) : "";
const indexMixtures = (kindMixtures ?? []).sort((a, b) =>
  (b.data.datePublished ?? "").localeCompare(a.data.datePublished ?? ""),
);
const indexCuisines = [
  ...new Set(indexMixtures.map((r) => r.data.recipeCuisine).filter((c): c is string => Boolean(c))),
].sort();
const indexTags = [...new Set(indexMixtures.flatMap((r) => keywordList(r.data.keywords)))].sort();
const indexGroups = [
  { key: "cuisine", label: t("filter.cuisine"), values: indexCuisines.map((v) => ({ value: v, label: v })) },
  { key: "tags", label: t("filter.tag"), values: indexTags.map((v) => ({ value: v, label: v })) },
];

const pageTitle = kind
  ? `Spicemixer — ${kindLabel}`
  : `${mix!.data.name} — Spicemixer`;
const pageDescription = kind ? t("page.mixtures.description") : mix!.data.description;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  {kind ? (
    <!-- Kind-plural index page -->
    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <nav class="mb-6 text-sm">
        <a href={`${prefix}/mixtures/`} class="text-stone-500 transition hover:text-stone-900">
          {t("nav.back.mixtures")}
        </a>
      </nav>

      <header class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">Spicemixer</p>
        <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900 sm:text-6xl">
          {kindLabel}
        </h1>
        <p class="mt-3 max-w-2xl text-lg text-stone-600">{t("page.mixtures.description")}</p>
      </header>

      <FilterBar groups={indexGroups} totalCount={indexMixtures.length} />

      <section class="columns-1 gap-6 sm:columns-2 lg:columns-3 xl:columns-4">
        {
          indexMixtures.map((mix) => {
            const href = `${prefix}/mixtures/${mix.id}/`;
            const image = firstImage(mix.data.image);
            const cardTags = keywordList(mix.data.keywords);
            const tn = `mixture-${mix.id}`;
            const fallbackLabel =
              [mix.data.recipeCategory, mix.data.recipeCuisine].filter(Boolean).join(" · ") ||
              t("recipe.fallback");
            return (
              <article
                data-filter-item
                data-filter-cuisine={mix.data.recipeCuisine ?? ""}
                data-filter-tags={cardTags.join(",")}
                class="mb-6 break-inside-avoid rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:shadow-md hover:ring-stone-300"
              >
                <a href={href} class="group block overflow-hidden rounded-2xl" style={`view-transition-name: ${tn};`}>
                  {image ? (
                    <>
                      <figure class="overflow-hidden">
                        <img src={image} alt={mix.data.name} loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]" />
                      </figure>
                      <div class="space-y-2 px-5 py-4">
                        <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-500">{fallbackLabel}</p>
                        <h3 class="font-serif text-xl leading-tight text-stone-900">{mix.data.name}</h3>
                        {mix.data.description && <p class="line-clamp-2 text-sm text-stone-600">{mix.data.description}</p>}
                        <RecipeMeta prepTime={mix.data.prepTime} totalTime={mix.data.totalTime} recipeYield={mix.data.recipeYield as string | number | undefined} />
                      </div>
                    </>
                  ) : (
                    <div class="bg-gradient-to-br from-amber-50 via-stone-50 to-orange-50 px-6 pb-2 pt-7">
                      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-500">{fallbackLabel}</p>
                      <h3 class="mt-2 font-serif text-3xl leading-tight text-stone-900">{mix.data.name}</h3>
                      {mix.data.description && <p class="mt-2 text-sm italic text-stone-600">{mix.data.description}</p>}
                      {mix.data.recipeIngredient.length > 0 && (
                        <ul class="mt-4 space-y-1 text-sm text-stone-700">
                          {mix.data.recipeIngredient.slice(0, 4).map((ing) => (
                            <li class="border-b border-dashed border-stone-300 pb-1 last:border-0">{ing}</li>
                          ))}
                          {mix.data.recipeIngredient.length > 4 && (
                            <li class="pt-1 text-xs text-stone-500">
                              {t("recipe.more").replace("{n}", String(mix.data.recipeIngredient.length - 4))}
                            </li>
                          )}
                        </ul>
                      )}
                      <div class="py-4">
                        <RecipeMeta prepTime={mix.data.prepTime} totalTime={mix.data.totalTime} recipeYield={mix.data.recipeYield as string | number | undefined} />
                      </div>
                    </div>
                  )}
                  {cardTags.length > 0 && (
                    <ul class="flex flex-wrap gap-1.5 px-5 pb-4 pt-0">
                      {cardTags.slice(0, 4).map((tag) => (
                        <li class="rounded-full bg-stone-100 px-2 py-0.5 text-[11px] text-stone-600">{tag}</li>
                      ))}
                    </ul>
                  )}
                </a>
              </article>
            );
          })
        }
      </section>

      <p data-empty-state hidden class="mt-16 text-center text-stone-500">{t("filter.empty")}</p>
    </main>
  ) : (
    <!-- Mixture detail page -->
    <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      <nav class="mb-8 flex items-center justify-between text-sm">
        <a
          href={`${prefix}/mixtures/`}
          class="text-stone-500 transition hover:text-stone-900"
        >
          {t("nav.back.mixtures")}
        </a>
        <a
          href={`/admin/mixtures/${mix!.id}/edit`}
          data-admin-link
          class="hidden text-xs text-stone-400 transition hover:text-stone-700"
        >
          Edit
        </a>
      </nav>

      <DetailLayout>
        <!-- hero: image/gradient + h1 + kind badge + description + jump to recipe -->
        <section slot="hero">
          {
            detailImage ? (
              <figure
                class="mb-8 overflow-hidden rounded-3xl"
                style={`view-transition-name: ${transitionName};`}
              >
                <img
                  src={detailImage}
                  alt={mix!.data.name}
                  class="aspect-[16/9] w-full object-cover"
                />
              </figure>
            ) : (
              <div
                class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-orange-50 p-10"
                style={`view-transition-name: ${transitionName};`}
              >
                <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
                  {[mix!.data.recipeCategory, mix!.data.recipeCuisine].filter(Boolean).join(" · ")}
                </p>
                <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">
                  {mix!.data.name}
                </h1>
              </div>
            )
          }

          {
            detailImage && (
              <header class="mb-6">
                <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
                  {[mix!.data.recipeCategory, mix!.data.recipeCuisine].filter(Boolean).join(" · ")}
                </p>
                <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">
                  {mix!.data.name}
                </h1>
              </header>
            )
          }

          {kindBadgeLabel && (
            <p class="mb-3">
              <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                {kindBadgeLabel}
              </span>
            </p>
          )}

          {mix!.data.description && (
            <p class="mb-4 text-lg italic text-stone-700">{mix!.data.description}</p>
          )}

          <a
            href="#recipe"
            class="mb-8 inline-block rounded-full bg-amber-700 px-5 py-2 text-sm font-medium text-white transition hover:bg-amber-800"
          >
            {t("section.jumpToRecipe")}
          </a>
        </section>

        <!-- encyclopedia: variant-of reference + external sources -->
        {(variantOfItem || (meta?.externalSources.length ?? 0) > 0) && (
          <section slot="encyclopedia" class="mb-10">
            {variantOfItem && (
              <p class="mb-4 text-sm text-stone-500">
                {t("section.variantOf")}{" "}
                <a
                  href={variantOfItem.href}
                  class="text-amber-700 underline decoration-dotted underline-offset-2 hover:text-amber-900"
                >
                  {variantOfItem.name}
                </a>
              </p>
            )}
            <ExternalSourceList
              heading={t("section.externalRecipes")}
              sources={meta!.externalSources}
            />
          </section>
        )}

        <!-- recipe: anchor target + RecipeMeta + ingredients + instructions + JSON-LD -->
        <section slot="recipe" id="recipe" class="mb-10">
          <div class="mb-10 rounded-2xl bg-white p-5 ring-1 ring-stone-200">
            <RecipeMeta
              prepTime={mix!.data.prepTime}
              cookTime={mix!.data.cookTime}
              totalTime={mix!.data.totalTime}
              recipeYield={mix!.data.recipeYield as string | number | undefined}
              variant="page"
            />
          </div>

          <section class="mb-10">
            <h2 class="mb-3 font-serif text-2xl text-stone-900">
              {t("section.ingredients")}
            </h2>
            <ul class="space-y-1.5">
              {
                linkedIngredients.map(({ text, slug: ingSlug }) => (
                  <li class="border-b border-dashed border-stone-200 pb-1.5 text-stone-800">
                    {ingSlug ? (
                      <a
                        href={`${ingredientBase}/${ingSlug}/`}
                        class="underline decoration-dotted underline-offset-2 text-amber-700 hover:text-amber-900"
                      >
                        {text}
                      </a>
                    ) : (
                      text
                    )}
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="mb-10">
            <h2 class="mb-3 font-serif text-2xl text-stone-900">
              {t("section.instructions")}
            </h2>
            <ol class="space-y-4">
              {
                detailSteps.map((step, i) => (
                  <li class="flex gap-4">
                    <span class="flex-none font-serif text-2xl text-stone-300">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="flex flex-1 items-start gap-3">
                      <p class="flex-1 text-stone-800">
                        {step.name && (
                          <strong class="block text-stone-900">{step.name}</strong>
                        )}
                        <Fragment
                          set:html={annotateTextHtml(
                            step.text,
                            meta!.ingredientLinks,
                            ingredientBase
                          )}
                        />
                      </p>
                      {step.image && <StepImage src={step.image} alt={step.name ?? ""} stepIndex={i} />}
                    </div>
                  </li>
                ))
              }
            </ol>
          </section>

          <script type="application/ld+json" set:html={jsonLd} />
        </section>

        <!-- relations: pairings + base + variants + tags -->
        <section slot="relations">
          <RelatedList heading={t("section.goesWellWith")} items={goesWellWithItems} />
          <RelatedList heading={t("section.usesBase")} items={usesBaseItems} />
          <RelatedList heading={t("section.variants")} items={variantItems} />

          {
            detailTags.length > 0 && (
              <footer class="border-t border-stone-200 pt-6">
                <ul class="flex flex-wrap gap-2">
                  {detailTags.map((tag) => (
                    <li class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">
                      {tag}
                    </li>
                  ))}
                </ul>
              </footer>
            )
          }
        </section>
      </DetailLayout>
    </main>
  )}

  {!kind && <StepsLightbox steps={lightboxSteps} />}
</BaseLayout>
