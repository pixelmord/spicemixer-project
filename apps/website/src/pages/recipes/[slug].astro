---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RecipeMeta from "../../components/RecipeMeta.astro";
import { firstImage, keywordList, normalizeInstructions } from "../../lib/instructions.ts";
import { useTranslations, type Lang } from "../../i18n/translations.ts";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { recipe } = Astro.props;
const data = recipe.data;
const slug = recipe.id;
const image = firstImage(data.image);
const tags = keywordList(data.keywords);
const steps = normalizeInstructions(data.recipeInstructions);
const transitionName = `recipe-${slug}`;
const jsonLd = JSON.stringify(data);

const t = useTranslations((Astro.currentLocale ?? "en") as Lang);
---

<BaseLayout title={`${data.name} — Spicemixer`} description={data.description}>
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-8 text-sm">
      <a href={Astro.currentLocale === "de" ? "/de/" : "/"} class="text-stone-500 transition hover:text-stone-900">
        {t("nav.back")}
      </a>
    </nav>

    {
      image ? (
        <figure
          class="mb-8 overflow-hidden rounded-3xl"
          style={`view-transition-name: ${transitionName};`}
        >
          <img
            src={image}
            alt={data.name}
            class="aspect-[16/9] w-full object-cover"
          />
        </figure>
      ) : (
        <div
          class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-emerald-50 p-10"
          style={`view-transition-name: ${transitionName};`}
        >
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
            {[data.recipeCategory, data.recipeCuisine].filter(Boolean).join(" · ") || t("recipe.fallback")}
          </p>
          <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">
            {data.name}
          </h1>
        </div>
      )
    }

    {
      image && (
        <header class="mb-6">
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
            {[data.recipeCategory, data.recipeCuisine].filter(Boolean).join(" · ") || t("recipe.fallback")}
          </p>
          <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">
            {data.name}
          </h1>
        </header>
      )
    }

    {
      data.description && (
        <p class="mb-6 text-lg italic text-stone-700">{data.description}</p>
      )
    }

    <div class="mb-10 rounded-2xl bg-white p-5 ring-1 ring-stone-200">
      <RecipeMeta
        prepTime={data.prepTime}
        cookTime={data.cookTime}
        totalTime={data.totalTime}
        recipeYield={data.recipeYield as string | number | undefined}
        variant="page"
      />
    </div>

    <section class="mb-10">
      <h2 class="mb-3 font-serif text-2xl text-stone-900">{t("section.ingredients")}</h2>
      <ul class="space-y-1.5">
        {
          data.recipeIngredient.map((ing) => (
            <li class="border-b border-dashed border-stone-200 pb-1.5 text-stone-800">
              {ing}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="mb-3 font-serif text-2xl text-stone-900">{t("section.instructions")}</h2>
      <ol class="space-y-4">
        {
          steps.map((step, i) => (
            <li class="flex gap-4">
              <span class="flex-none font-serif text-2xl text-stone-300">
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="text-stone-800">
                {step.name && <strong class="block text-stone-900">{step.name}</strong>}
                {step.text}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      tags.length > 0 && (
        <footer class="border-t border-stone-200 pt-6">
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">
                {tag}
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </main>

  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>
