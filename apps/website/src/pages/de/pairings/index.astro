---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FilterBar from "../../../components/FilterBar.astro";
import { getPublishedPairings } from "../../../lib/recipe-augment.ts";
import { REGIONS, REGION_LABELS } from "../../../lib/regions.ts";
import { useTranslations } from "../../../i18n/translations.ts";

const t = useTranslations("de");
const locale = "de";
const prefix = "/de";

const pairings = await getPublishedPairings();

const recentlyAdded = pairings.slice(0, 6);

const presentRegions = REGIONS.filter((r) => pairings.some((p) => p.regions.includes(r)));

const groups = [
  {
    key: "region",
    label: t("filter.region"),
    values: presentRegions.map((r) => ({ value: r, label: REGION_LABELS[r].de })),
  },
];
---

<BaseLayout title={t("page.pairings.title")} description={t("page.pairings.description")}>
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">Spicemixer</p>
      <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900 sm:text-6xl">
        {t("page.pairings.tagline")}
      </h1>
      <p class="mt-3 max-w-2xl text-lg text-stone-600">{t("page.pairings.description")}</p>
    </header>

    {
      recentlyAdded.length > 0 && (
        <section class="mb-12">
          <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">
            {t("page.pairings.recentlyAdded")}
          </h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {recentlyAdded.map((pairing) => {
              const [a, b] = pairing.ingredients;
              const description = pairing.descriptions[locale] ?? pairing.descriptions["en"] ?? "";
              const href = `${prefix}/pairings/${pairing.id}/`;
              return (
                <a
                  href={href}
                  class="group rounded-2xl bg-white p-5 shadow-sm ring-1 ring-stone-200 transition hover:shadow-md hover:ring-stone-300"
                >
                  <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-500">
                    {a} + {b}
                  </p>
                  {description && (
                    <p class="mt-2 line-clamp-3 text-sm text-stone-600">{description}</p>
                  )}
                  {pairing.regions.length > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-1">
                      {pairing.regions.slice(0, 2).map((r) => (
                        <li class="rounded-full bg-stone-100 px-2 py-0.5 text-[10px] text-stone-500">
                          {REGION_LABELS[r as keyof typeof REGION_LABELS]?.de ?? r}
                        </li>
                      ))}
                    </ul>
                  )}
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <FilterBar groups={groups} totalCount={pairings.length} />

    <section class="columns-1 gap-6 sm:columns-2 lg:columns-3 xl:columns-4">
      {
        pairings.map((pairing) => {
          const [a, b] = pairing.ingredients;
          const description = pairing.descriptions[locale] ?? pairing.descriptions["en"] ?? "";
          const href = `${prefix}/pairings/${pairing.id}/`;
          return (
            <article
              data-filter-item
              data-filter-region={pairing.regions.join(",")}
              class="mb-6 break-inside-avoid rounded-2xl bg-white shadow-sm ring-1 ring-stone-200 transition hover:shadow-md hover:ring-stone-300"
            >
              <a href={href} class="group block overflow-hidden rounded-2xl">
                {pairing.image ? (
                  <>
                    <figure class="overflow-hidden">
                      <img
                        src={pairing.image}
                        alt={`${a} + ${b}`}
                        loading="lazy"
                        class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                      />
                    </figure>
                    <div class="px-5 py-4">
                      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-500">
                        {a} + {b}
                      </p>
                      {description && (
                        <p class="mt-1 line-clamp-2 text-sm text-stone-600">{description}</p>
                      )}
                    </div>
                  </>
                ) : (
                  <div class="bg-gradient-to-br from-teal-50 via-stone-50 to-cyan-50 px-6 pb-5 pt-7">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-stone-500">
                      {a} + {b}
                    </p>
                    <p class="mt-2 font-serif text-2xl leading-tight text-stone-900">
                      {a} <span class="text-stone-400">&amp;</span> {b}
                    </p>
                    {description && (
                      <p class="mt-2 line-clamp-3 text-sm italic text-stone-600">{description}</p>
                    )}
                    {pairing.regions.length > 0 && (
                      <ul class="mt-3 flex flex-wrap gap-1">
                        {pairing.regions.slice(0, 2).map((r) => (
                          <li class="rounded-full bg-white/60 px-2 py-0.5 text-[10px] text-stone-500">
                            {REGION_LABELS[r as keyof typeof REGION_LABELS]?.de ?? r}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                )}
              </a>
            </article>
          );
        })
      }
    </section>

    <p data-empty-state hidden class="mt-16 text-center text-stone-500">{t("filter.empty")}</p>

    {
      pairings.length === 0 && (
        <p class="mt-16 text-center text-stone-500">{t("filter.empty")}</p>
      )
    }
  </main>
</BaseLayout>
