---
import { type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DetailLayout from "../../../components/DetailLayout.astro";
import RecipeMeta from "../../../components/RecipeMeta.astro";
import RelatedList from "../../../components/RelatedList.astro";
import ExternalSourceList from "../../../components/ExternalSourceList.astro";
import TranslationFallbackBanner from "../../../components/TranslationFallbackBanner.astro";
import { firstImage, keywordList, normalizeInstructions } from "../../../lib/instructions.ts";
import StepImage from "../../../components/StepImage.astro";
import StepsLightbox from "../../../components/StepsLightbox.astro";
import {
  getMeta,
  getPublished,
  slugFromLocaleId,
  getIngredient,
  linkIngredients,
  annotateTextHtml,
  resolveRefs,
} from "../../../lib/recipe-augment.ts";
import { useTranslations } from "../../../i18n/translations.ts";
import CookModeToggle from "../../../components/CookModeToggle.tsx";
import { withPagefindFilters } from "../../../lib/withPagefindFilters.ts";
import { resolvePublished } from "../../../lib/published-entity.ts";
import { hreflangTags } from "../../../lib/hreflang.ts";

export async function getStaticPaths() {
  const enEntries = await getPublished("recipes", "en");
  const paths = await Promise.all(
    enEntries.map(async (entry) => {
      const slug = slugFromLocaleId(entry.id);
      const resolved = await resolvePublished("recipes", slug, "de");
      if (!resolved) return null;
      return {
        params: { slug },
        props: {
          recipe: resolved.entity as CollectionEntry<"recipes">,
          isFallback: resolved.isFallback,
          canonicalLocale: resolved.canonicalLocale,
        },
      };
    }),
  );
  return paths.filter((p): p is NonNullable<typeof p> => p !== null);
}

interface Props {
  recipe: CollectionEntry<"recipes">;
  isFallback: boolean;
  canonicalLocale: string;
}

const { recipe, isFallback, canonicalLocale } = Astro.props;
const data = recipe.data;
const slug = Astro.params.slug as string;
const image = firstImage(data.image);
const tags = keywordList(data.keywords);
const steps = normalizeInstructions(data.recipeInstructions);
const transitionName = `recipe-${slug}`;
const jsonLd = JSON.stringify(data);

const t = useTranslations("de");
const prefix = "/de";
const ingredientBase = "/de/ingredients";
const locale = "de";

const meta = await getMeta("recipes", locale, slug);
const pagefindFilters = withPagefindFilters({
  cuisine: data.recipeCuisine ?? undefined,
  category: data.recipeCategory ?? undefined,
  region: meta.region,
});

const linkedIngredients = linkIngredients(data.recipeIngredient, meta.ingredientLinks);
const goesWellWithItems = await resolveRefs(meta.goesWellWith, prefix);
const lightboxSteps = steps.map((step) => ({
  ...step,
  html: annotateTextHtml(step.text, meta.ingredientLinks, ingredientBase),
}));

const uniqueIngredientSlugs = [
  ...new Set(
    meta.ingredientLinks
      .filter((l) => !l.kind || l.kind === "ingredient")
      .map((l) => l.slug),
  ),
];
const demonstratesItems = await Promise.all(
  uniqueIngredientSlugs.map(async (ingSlug) => {
    const entry = await getIngredient(ingSlug, locale);
    return {
      name: entry?.data.name ?? ingSlug,
      href: `${ingredientBase}/${ingSlug}/`,
    };
  }),
);

const hreflang = await hreflangTags(slug, "recipes", Astro.site?.toString().replace(/\/$/, "") ?? "");
---

<BaseLayout title={`${data.name} — Spicemixer`} description={data.description}>
  <Fragment slot="head">
    {hreflang.map((tag) => (
      <link rel="alternate" hreflang={tag.hrefLang} href={tag.href} />
    ))}
  </Fragment>

  <main
    class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8"
    data-pagefind-body
  >
    {Object.entries(pagefindFilters).map(([key, value]) => (
      <span data-pagefind-filter={`${key}:${value}`} hidden aria-hidden="true" />
    ))}
    <nav class="mb-8 text-sm">
      <a href="/de/recipes/" class="text-stone-500 transition hover:text-stone-900">
        {t("nav.back")}
      </a>
    </nav>

    {isFallback && (
      <TranslationFallbackBanner requestedLocale={locale} canonicalLocale={canonicalLocale} />
    )}

    <DetailLayout>
      <section slot="hero" data-cook="compact">
        {
          image ? (
            <figure
              class="mb-8 overflow-hidden rounded-3xl"
              style={`view-transition-name: ${transitionName};`}
            >
              <img src={image} alt={data.name} class="aspect-[16/9] w-full object-cover" />
            </figure>
          ) : (
            <div
              class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-emerald-50 p-10"
              style={`view-transition-name: ${transitionName};`}
            >
              <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
                {[data.recipeCategory, data.recipeCuisine].filter(Boolean).join(" · ") || t("recipe.fallback")}
              </p>
              <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">{data.name}</h1>
            </div>
          )
        }

        {
          image && (
            <header class="mb-6">
              <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
                {[data.recipeCategory, data.recipeCuisine].filter(Boolean).join(" · ") || t("recipe.fallback")}
              </p>
              <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">{data.name}</h1>
            </header>
          )
        }

        {data.description && <p class="mb-6 text-lg italic text-stone-700">{data.description}</p>}

        <div class="mb-8 flex flex-wrap items-center gap-3">
          <a
            href="#recipe"
            class="inline-block rounded-full bg-amber-700 px-5 py-2 text-sm font-medium text-white transition hover:bg-amber-800"
          >
            {t("section.jumpToRecipe")}
          </a>
          <CookModeToggle
            labels={{ enter: t("cook.enter"), exit: t("cook.exit") }}
            client:load
          />
        </div>
      </section>

      {demonstratesItems.length > 0 && (
        <section slot="encyclopedia" data-cook="hide" class="mb-8">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-stone-500">
            {t("section.demonstrates")}
          </p>
          <ul class="flex flex-wrap gap-2">
            {demonstratesItems.map(({ name, href }) => (
              <li>
                <a
                  href={href}
                  class="rounded-full bg-stone-100 px-3 py-1 text-sm text-stone-700 underline decoration-dotted underline-offset-2 hover:bg-stone-200 hover:text-stone-900"
                >
                  {name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section slot="recipe" id="recipe" class="mb-10">
        <div class="mb-10 rounded-2xl bg-white p-5 ring-1 ring-stone-200">
          <RecipeMeta
            prepTime={data.prepTime}
            cookTime={data.cookTime}
            totalTime={data.totalTime}
            recipeYield={data.recipeYield as string | number | undefined}
            variant="page"
          />
        </div>

        <section class="mb-10">
          <h2 class="mb-3 font-serif text-2xl text-stone-900">{t("section.ingredients")}</h2>
          <ul class="space-y-1.5">
            {linkedIngredients.map(({ text, slug: ingSlug }) => (
              <li class="border-b border-dashed border-stone-200 pb-1.5 text-stone-800">
                {ingSlug ? (
                  <a href={`${ingredientBase}/${ingSlug}/`} class="underline decoration-dotted underline-offset-2 text-amber-700 hover:text-amber-900">
                    {text}
                  </a>
                ) : text}
              </li>
            ))}
          </ul>
        </section>

        <section class="mb-10">
          <h2 class="mb-3 font-serif text-2xl text-stone-900">{t("section.instructions")}</h2>
          <ol class="space-y-4">
            {steps.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex-none font-serif text-2xl text-stone-300">{String(i + 1).padStart(2, "0")}</span>
                <div class="flex flex-1 items-start gap-3">
                  <p class="flex-1 text-stone-800">
                    {step.name && <strong class="block text-stone-900">{step.name}</strong>}
                    <Fragment set:html={annotateTextHtml(step.text, meta.ingredientLinks, ingredientBase)} />
                  </p>
                  {step.image && <StepImage src={step.image} alt={step.name ?? ""} stepIndex={i} />}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <script type="application/ld+json" set:html={jsonLd} />
      </section>

      <section slot="relations" data-cook="hide">
        <RelatedList heading={t("section.goesWellWith")} items={goesWellWithItems} />
        <ExternalSourceList heading={t("section.externalRecipes")} sources={meta.externalSources} />

        {tags.length > 0 && (
          <footer class="border-t border-stone-200 pt-6">
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">{tag}</li>
              ))}
            </ul>
          </footer>
        )}
      </section>
    </DetailLayout>
  </main>

  <StepsLightbox steps={lightboxSteps} />
</BaseLayout>
