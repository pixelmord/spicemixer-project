---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RelatedList from "../../../components/RelatedList.astro";
import { useTranslations } from "../../../i18n/translations.ts";
import IngredientTaxonomy from "../../../components/IngredientTaxonomy.astro";
import { getUsedIn, getIngredient, getPairings, getPublishedIngredients } from "../../../lib/recipe-augment.ts";
import { renderInlineMarkdown } from "../../../lib/inline-markdown.ts";
import { INGREDIENT_LONGFORM_FIELDS } from "../../../lib/ingredient-schema.ts";

export async function getStaticPaths() {
  const all = await getPublishedIngredients();
  const enEntries = all.filter((e) => e.id.startsWith("en/"));
  const deEntries = all.filter((e) => e.id.startsWith("de/"));

  return enEntries.map((en) => {
    const slug = en.id.replace(/^en\//, "");
    const de = deEntries.find((e) => e.id === `de/${slug}`);
    return {
      params: { slug },
      props: { ingredient: de ?? en },
    };
  });
}

const { ingredient } = Astro.props;
const data = ingredient.data;
const slug = ingredient.id.replace(/^(en|de)\//, "");

const t = useTranslations("de");
const locale = "de";
const prefix = "/de";

const SECTION_LABELS: Record<(typeof INGREDIENT_LONGFORM_FIELDS)[number], string> = {
  culinaryUse: "Kulinarische Verwendung",
  medicinalUses: "Medizinische Anwendungen",
  healthBenefits: "Gesundheitsvorteile",
  safetyNotes: "Sicherheitshinweise",
  history: "Geschichte",
  storage: "Lagerung",
  sourcing: "Bezugsquellen",
};

const usedIn = await getUsedIn(slug, prefix);

// Use pairings collection (bidirectional), fall back to legacy inline pairings
const pairingEntities = await getPairings(slug);
const pairingsResolved = pairingEntities.length > 0
  ? await Promise.all(
      pairingEntities.map(async (pairing) => {
        const otherSlug = pairing.ingredients[0] === slug ? pairing.ingredients[1] : pairing.ingredients[0];
        const entry = await getIngredient(otherSlug, locale);
        const descriptions = pairing.descriptions ?? {};
        const description = descriptions[locale] ?? descriptions["en"] ?? pairing.description ?? "";
        const isFallback = !descriptions[locale] && (!!descriptions["en"] || !!pairing.description);
        return { slug: otherSlug, name: entry?.data.name ?? otherSlug, description, isFallback };
      })
    )
  : await Promise.all(
      (data.pairings ?? []).map(async ({ slug: pairSlug, note }) => {
        const entry = await getIngredient(pairSlug, locale);
        return { slug: pairSlug, name: entry?.data.name ?? pairSlug, description: note ?? "", isFallback: false };
      })
    );
---

<BaseLayout title={`${data.name} — Spicemixer`} description={data.summary}>
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-8 text-sm">
      <a
        href="/de/ingredients/"
        class="text-stone-500 transition hover:text-stone-900"
      >
        {t("nav.back.ingredients")}
      </a>
    </nav>

    {
      data.images[0] ? (
        <figure class="mb-8 overflow-hidden rounded-3xl">
          <img
            src={data.images[0]}
            alt={data.name}
            class="aspect-[16/9] w-full object-cover"
          />
        </figure>
      ) : (
        <div class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-rose-50 p-10">
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
            {data.category}
          </p>
          <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">
            {data.name}
          </h1>
        </div>
      )
    }

    {
      data.images[0] && (
        <header class="mb-6">
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
            {data.category}
          </p>
          <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">
            {data.name}
          </h1>
        </header>
      )
    }

    {
      data.summary && (
        <p class="mb-6 text-lg italic text-stone-700">{data.summary}</p>
      )
    }

    <IngredientTaxonomy data={data} t={t} />

    {
      data.description && (
        <section class="mb-10">
          <p class="leading-relaxed text-stone-800" set:html={renderInlineMarkdown(data.description)} />
        </section>
      )
    }

    {
      INGREDIENT_LONGFORM_FIELDS.map((field) => {
        const text = data[field];
        if (!text) return null;
        return (
          <section class="mb-10">
            <h2 class="mb-3 font-serif text-2xl text-stone-900">{SECTION_LABELS[field]}</h2>
            <div class="leading-relaxed text-stone-800" set:html={renderInlineMarkdown(text)} />
          </section>
        );
      })
    }

    {
      data.images.length > 1 && (
        <section class="mb-10">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
            {data.images.slice(1).map((src) => (
              <figure class="overflow-hidden rounded-2xl">
                <img
                  src={src}
                  alt={data.name}
                  class="aspect-square w-full object-cover"
                />
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      pairingsResolved.length > 0 && (
        <section class="mb-10">
          <h2 class="mb-4 font-serif text-2xl text-stone-900">
            {t("section.pairings")}
          </h2>
          <ul class="space-y-3">
            {pairingsResolved.map(({ slug: pairSlug, name, description, isFallback }) => (
              <li class="rounded-xl bg-white p-4 ring-1 ring-stone-200">
                <a
                  href={`/de/ingredients/${pairSlug}/`}
                  class="font-medium text-amber-700 underline decoration-dotted underline-offset-2 hover:text-amber-900"
                >
                  {name}
                </a>
                {description && (
                  <p class={`mt-1 text-sm ${isFallback ? "text-stone-400 italic" : "text-stone-600"}`}>
                    {description}
                    {isFallback && <span class="ml-1 text-xs not-italic">(EN)</span>}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedList heading={t("section.usedIn")} items={usedIn} />
  </main>
</BaseLayout>
