---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { scoreRecipe } from "@/lib/completeness.ts";
import { groupBySlug } from "@/lib/admin-list-rows.ts";

const store = await createStore();
const [items, metas] = await Promise.all([store.list("mixtures"), store.list("meta")]);
const metaMap = new Map(metas.map((m) => [m.id, m.data as Record<string, unknown>]));

const rows = groupBySlug(items, (item) => {
  const meta = metaMap.get(`mixtures/${item.id}`);
  const t = meta?.["translations"];
  return t && typeof t === "object" ? (t as Record<string, string>) : undefined;
}).map(({ slug, primary, translations }) => {
  const meta = (metaMap.get(`mixtures/${primary.id}`) ?? {}) as Record<string, unknown>;
  const completeness = scoreRecipe(primary.data as never, meta as never);
  return {
    type: "recipe" as const,
    collection: "mixtures",
    id: primary.id,
    name: String((primary.data as Record<string, unknown>).name ?? slug),
    draft: !!meta.draft,
    completeness,
    updatedAt: primary.updatedAt,
    translations,
  };
});
---
<AdminLayout title="Mixtures · Admin · SpiceMixer">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold">Mixtures</h1>
      <div class="flex gap-2">
        <a href="/admin/mixtures/import" class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-2.5 h-8 text-sm font-medium hover:bg-muted transition-colors">Import from URL</a>
        <a href="/admin/mixtures/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">+ New mixture</a>
      </div>
    </div>
    <ContentTable initialRows={rows} client:load />
  </div>
</AdminLayout>
