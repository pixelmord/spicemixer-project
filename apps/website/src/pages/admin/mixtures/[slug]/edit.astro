---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import RecipeForm from "@/components/admin/RecipeForm.tsx";
import { createStore } from "@/lib/content-store.ts";

const LOCALES = ["en", "de"] as const;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin/mixtures");

const store = await createStore();

// Locale lives in the folder — scan supported locales to find the content.
let item = null;
let metaItem = null;
for (const loc of LOCALES) {
  const candidate = await store.get("mixtures", `${loc}/${slug}`);
  if (candidate) {
    item = candidate;
    metaItem = await store.get("meta", `mixtures/${loc}/${slug}`);
    break;
  }
}

if (!item) return Astro.redirect("/admin/mixtures");

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head><meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" /><title>{String((item.data as Record<string, unknown>).name ?? slug)} · Edit · Admin</title></head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <RecipeForm collection="mixtures" slug={slug} initialRecipe={item.data as never} initialMeta={metaItem?.data as never} client:load />
    </AdminShell>
  </body>
</html>
