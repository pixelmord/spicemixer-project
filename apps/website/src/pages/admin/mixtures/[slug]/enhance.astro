---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import RecipeEnhancePage from "@/components/admin/RecipeEnhancePage.tsx";
import { createStore } from "@/lib/content-store.ts";

const LOCALES = ["en", "de"] as const;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin/mixtures");

const store = await createStore();
let item = null;
let itemLocale: "en" | "de" = "en";
for (const loc of LOCALES) {
  const candidate = await store.get("mixtures", `${loc}/${slug}`);
  if (candidate) {
    item = candidate;
    itemLocale = loc;
    break;
  }
}
if (!item) return Astro.redirect("/admin/mixtures");

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Enhance · {String((item.data as Record<string, unknown>).name ?? slug)} · Admin</title>
  </head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <RecipeEnhancePage
        collection="mixtures"
        slug={slug}
        locale={itemLocale}
        existingRecipe={item.data as never}
        client:load
      />
    </AdminShell>
  </body>
</html>
