---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import RecipeEnhancePage from "@/components/admin/RecipeEnhancePage.tsx";
import { createStore } from "@/lib/content-store.ts";

const LOCALES = ["en", "de"] as const;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin/mixtures");

const store = await createStore();
let item = null;
let itemLocale: "en" | "de" = "en";
for (const loc of LOCALES) {
  const candidate = await store.get("mixtures", `${loc}/${slug}`);
  if (candidate) {
    item = candidate;
    itemLocale = loc;
    break;
  }
}
if (!item) return Astro.redirect("/admin/mixtures");

const title = `Enhance · ${String((item.data as Record<string, unknown>).name ?? slug)} · Admin`;
---

<AdminLayout title={title}>
  <RecipeEnhancePage
    collection="mixtures"
    slug={slug}
    locale={itemLocale}
    existingRecipe={item.data as never}
    client:load
  />
</AdminLayout>
