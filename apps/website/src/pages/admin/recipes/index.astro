---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { scoreRecipe } from "@/lib/completeness.ts";

const store = await createStore();
const [items, metas] = await Promise.all([store.list("recipes"), store.list("meta")]);
const metaMap = new Map(metas.map((m) => [m.id, m.data as Record<string, unknown>]));

const rows = items.map((item) => {
  const meta = metaMap.get(`recipes/${item.id}`) ?? {};
  const completeness = scoreRecipe(item.data as never, meta as never);
  const language = String((meta as Record<string, unknown>).language ?? "") || undefined;
  return {
    type: "recipe" as const,
    collection: "recipes",
    id: item.id,
    name: String((item.data as Record<string, unknown>).name ?? item.id),
    draft: !!(meta as Record<string, unknown>).draft,
    completeness,
    updatedAt: item.updatedAt,
    language,
  };
});
---

<AdminLayout title="Recipes · Admin · SpiceMixer">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold">Recipes</h1>
      <div class="flex gap-2">
        <a href="/admin/recipes/import" class="inline-flex items-center justify-center rounded-lg border border-border bg-background px-2.5 h-8 text-sm font-medium hover:bg-muted transition-colors">Import from URL</a>
        <a href="/admin/recipes/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">+ New recipe</a>
      </div>
    </div>
    <ContentTable initialRows={rows} client:load />
  </div>
</AdminLayout>
