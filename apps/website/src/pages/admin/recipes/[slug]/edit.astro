---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import RecipeForm from "@/components/admin/RecipeForm.tsx";
import { createStore } from "@/lib/content-store.ts";
const LOCALES = ["en", "de"] as const;

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin/recipes");

const store = await createStore();

const localeParam = Astro.url.searchParams.get("locale");
const localeOrder = LOCALES.includes(localeParam as (typeof LOCALES)[number])
  ? ([localeParam, ...LOCALES.filter((l) => l !== localeParam)] as readonly string[])
  : LOCALES;

let item = null;
let metaItem = null;
for (const loc of localeOrder) {
  const candidate = await store.get("recipes", `${loc}/${slug}`);
  if (candidate) {
    item = candidate;
    metaItem = await store.get("meta", `recipes/${loc}/${slug}`);
    break;
  }
}

if (!item) return Astro.redirect("/admin/recipes");

const title = `${String((item.data as Record<string, unknown>).name ?? slug)} · Edit · Admin`;
---

<AdminLayout title={title}>
  <RecipeForm
    collection="recipes"
    slug={slug}
    initialRecipe={item.data as never}
    initialMeta={metaItem?.data as never}
    client:load
  />
</AdminLayout>
