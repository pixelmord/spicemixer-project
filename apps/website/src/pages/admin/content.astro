---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { actions } from "astro:actions";

const { data: rows = [], error } = await Astro.callAction(actions.listAll, undefined as never);
---

<AdminLayout title="All content · Admin · SpiceMixer">
  <div class="space-y-4">
    <h1 class="text-2xl font-bold">All content</h1>
    {error && <p class="text-destructive text-sm">{error.message}</p>}
    <ContentTable initialRows={rows} client:load />
  </div>
</AdminLayout>
