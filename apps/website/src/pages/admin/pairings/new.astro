---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import NewPairingPage from "@/components/admin/NewPairingPage.tsx";

const locale = (Astro.url.searchParams.get("locale") ?? "en") as "en" | "de";
const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New pairing · Admin</title>
  </head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <NewPairingPage locale={locale} client:load />
    </AdminShell>
  </body>
</html>
