---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { scorePairing } from "@/lib/completeness.ts";

const store = await createStore();
const allItems = await store.list("pairings");

// Group by pairing slug, deduplicate to one row per slug
const slugMap = new Map<string, typeof allItems[number][]>();
for (const item of allItems) {
  const slash = item.id.indexOf("/");
  if (slash === -1) continue; // skip stale root-level files
  const slug = item.id.slice(slash + 1);
  if (!slugMap.has(slug)) slugMap.set(slug, []);
  slugMap.get(slug)!.push(item);
}

const rows = Array.from(slugMap.entries()).map(([slug, localeItems]) => {
  // Primary: EN version, fall back to first available
  const primary =
    localeItems.find((i) => i.id.startsWith("en/")) ?? localeItems[0]!;
  const d = primary.data as Record<string, unknown>;
  const endpoints = (d["endpoints"] as Array<{ collection: string; slug: string }>) ?? [];
  const ep0 = endpoints[0]?.slug ?? "?";
  const ep1 = endpoints[1]?.slug ?? "?";
  const description = typeof d["description"] === "string" ? d["description"] : "";
  const completeness = scorePairing(d);
  const translations = localeItems
    .map((i) => i.id.slice(0, i.id.indexOf("/")))
    .filter(Boolean)
    .sort();
  return {
    type: "pairing" as const,
    collection: "pairings",
    id: primary.id,
    name: `${ep0} ↔ ${ep1}`,
    draft: false,
    completeness,
    updatedAt: primary.updatedAt,
    translations,
    subtitle: description
      ? description.slice(0, 100) + (description.length > 100 ? "…" : "")
      : undefined,
  };
});

---
<AdminLayout title="Pairings · Admin · SpiceMixer">
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold">Pairings</h1>
          <a href="/admin/pairings/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">
            + New pairing
          </a>
        </div>
        <ContentTable initialRows={rows} client:load />
      </div>
</AdminLayout>
