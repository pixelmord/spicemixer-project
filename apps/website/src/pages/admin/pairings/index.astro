---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { PAIRING_META } from "@/lib/meta-sidecar.ts";
import { scorePairing } from "@/lib/completeness.ts";

const store = await createStore();
const [items, metaItems] = await Promise.all([
  store.list("pairings"),
  store.list(PAIRING_META),
]);

const metaMap = new Map(metaItems.map((m) => [m.id, m.data as Record<string, unknown>]));

const rows = items.map((item) => {
  const d = item.data as Record<string, unknown>;
  const ings = (d["ingredients"] as string[]) ?? [];
  const descriptions = (d["descriptions"] as Record<string, string>) ?? {};
  const translations = ["en", "de"].filter((l) => !!descriptions[l]);
  const meta = metaMap.get(item.id) ?? {};
  const draft = !!(meta["draft"] as boolean);
  const completeness = scorePairing(d, "en");
  const description = descriptions["en"] ?? String(d["description"] ?? "");
  return {
    type: "pairing" as const,
    collection: "pairings",
    id: item.id,
    name: `${ings[0] ?? "?"} ↔ ${ings[1] ?? "?"}`,
    draft,
    completeness,
    updatedAt: item.updatedAt,
    translations,
    subtitle: description ? description.slice(0, 100) + (description.length > 100 ? "…" : "") : undefined,
  };
});

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <title>Pairings · Admin · SpiceMixer</title>
  </head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold">Pairings</h1>
          <a href="/admin/pairings/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">
            + New pairing
          </a>
        </div>
        <ContentTable initialRows={rows} client:load />
      </div>
    </AdminShell>
  </body>
</html>
