---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import IngredientForm from "@/components/admin/IngredientForm.tsx";
import { createStore } from "@/lib/content-store.ts";

const { slug } = Astro.params;
// Locale lives in ?locale=en|de to avoid Astro i18n routing stripping the default
// locale ("en") from path segments like /admin/ingredients/en/sumac/edit → 404.
const locale = (Astro.url.searchParams.get("locale") ?? "en") as "en" | "de";

if (!slug) return Astro.redirect("/admin/ingredients");

const store = await createStore();
const item = await store.get("ingredients", `${locale}/${slug}`);
if (!item) return Astro.redirect("/admin/ingredients");

// Load ingredient meta (AI suggestions cache) and pairings
const metaItem = await store.get("ingredientMeta", `${locale}/${slug}`);
const allPairings = await store.list("pairings");
const ingredientPairings = allPairings
  .filter((p) => {
    const d = p.data as Record<string, unknown>;
    const ings = d["ingredients"];
    return Array.isArray(ings) && ings.includes(slug);
  })
  .map((p) => {
    const d = p.data as Record<string, unknown>;
    const descriptions =
      (d["descriptions"] as Record<string, string>) ??
      (d["description"] ? { en: String(d["description"]) } : {});
    return {
      id: p.id,
      ingredients: d["ingredients"] as [string, string],
      descriptions,
    };
  });

// Check which other locales already have a translation of this ingredient
const otherLocale = locale === "en" ? "de" : "en";
const otherItem = await store.get("ingredients", `${otherLocale}/${slug}`);
const existingTranslationLocales = otherItem ? [otherLocale] : [];

const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{String((item.data as Record<string, unknown>).name ?? slug)} [{locale}] · Edit · Admin</title>
  </head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <IngredientForm
        locale={locale}
        slug={slug}
        initialData={item.data as never}
        initialMeta={metaItem?.data as never ?? {}}
        initialPairings={ingredientPairings as never}
        existingTranslationLocales={existingTranslationLocales}
        client:load
      />
    </AdminShell>
  </body>
</html>
