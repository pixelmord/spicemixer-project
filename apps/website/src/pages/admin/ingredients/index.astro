---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { scoreIngredient } from "@/lib/completeness.ts";

const store = await createStore();
const allItems = await store.list("ingredients");

// Group by slug, deduplicate to one row per ingredient
const slugMap = new Map<string, typeof allItems[number][]>();
for (const item of allItems) {
  const slash = item.id.indexOf("/");
  if (slash === -1) continue;
  const slug = item.id.slice(slash + 1);
  if (!slugMap.has(slug)) slugMap.set(slug, []);
  slugMap.get(slug)!.push(item);
}

const rows = Array.from(slugMap.entries()).map(([slug, localeItems]) => {
  // Primary: EN version, fall back to first available
  const primary =
    localeItems.find((i) => i.id.startsWith("en/")) ?? localeItems[0]!;
  const completeness = scoreIngredient(primary.data as never);
  const translations = localeItems
    .map((i) => i.id.slice(0, i.id.indexOf("/")))
    .filter(Boolean)
    .sort();
  return {
    type: "ingredient" as const,
    collection: "ingredients",
    id: primary.id, // e.g. "en/cardamom" — editHref strips locale correctly
    name: String((primary.data as Record<string, unknown>).name ?? slug),
    draft: false,
    completeness,
    updatedAt: primary.updatedAt,
    translations,
  };
});

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head><meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" /><title>Ingredients · Admin · SpiceMixer</title></head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold">Ingredients</h1>
          <a href="/admin/ingredients/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">+ New ingredient</a>
        </div>
        <ContentTable initialRows={rows} client:load />
      </div>
    </AdminShell>
  </body>
</html>
