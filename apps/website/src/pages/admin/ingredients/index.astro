---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { scoreIngredient } from "@/lib/completeness.ts";

const store = await createStore();
const items = await store.list("ingredients");

// Build a set of slugs per locale for translation status
const slugsByLocale = new Map<string, Set<string>>();
for (const item of items) {
  const slash = item.id.indexOf("/");
  if (slash === -1) continue;
  const locale = item.id.slice(0, slash);
  const slug = item.id.slice(slash + 1);
  if (!slugsByLocale.has(locale)) slugsByLocale.set(locale, new Set());
  slugsByLocale.get(locale)!.add(slug);
}

const rows = items.map((item) => {
  const completeness = scoreIngredient(item.data as never);
  const slash = item.id.indexOf("/");
  const slug = slash !== -1 ? item.id.slice(slash + 1) : item.id;
  // Collect which locales have a version of this slug
  const translations = ["en", "de"].filter((l) => slugsByLocale.get(l)?.has(slug));
  return { type: "ingredient" as const, collection: "ingredients", id: item.id, name: String((item.data as Record<string, unknown>).name ?? item.id), draft: false, completeness, updatedAt: item.updatedAt, translations };
});

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head><meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" /><title>Ingredients · Admin · SpiceMixer</title></head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold">Ingredients</h1>
          <a href="/admin/ingredients/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">+ New ingredient</a>
        </div>
        <ContentTable initialRows={rows} client:load />
      </div>
    </AdminShell>
  </body>
</html>
