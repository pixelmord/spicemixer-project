---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ContentTable from "@/components/admin/ContentTable.tsx";
import { createStore } from "@/lib/content-store.ts";
import { scoreIngredient } from "@/lib/completeness.ts";
import { groupBySlug } from "@/lib/admin-list-rows.ts";

const store = await createStore();
const allItems = await store.list("ingredients");

const rows = groupBySlug(allItems).map(({ slug, primary, translations }) => {
  const completeness = scoreIngredient(primary.data as never);
  return {
    type: "ingredient" as const,
    collection: "ingredients",
    id: primary.id,
    name: String((primary.data as Record<string, unknown>).name ?? slug),
    draft: false,
    completeness,
    updatedAt: primary.updatedAt,
    translations,
  };
});
---
<AdminLayout title="Ingredients · Admin · SpiceMixer">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold">Ingredients</h1>
      <a href="/admin/ingredients/new" class="inline-flex items-center justify-center rounded-lg bg-primary text-primary-foreground px-2.5 h-8 text-sm font-medium hover:opacity-90 transition-colors">+ New ingredient</a>
    </div>
    <ContentTable initialRows={rows} client:load />
  </div>
</AdminLayout>
