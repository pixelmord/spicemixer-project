---
export const prerender = false;
import AdminShell from "@/components/admin/AdminShell.tsx";
import RecipeForm from "@/components/admin/RecipeForm.tsx";
import { createStore } from "@/lib/content-store.ts";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/admin/spicemixes");

const store = await createStore();
const [item, metaItem] = await Promise.all([store.get("spicemixes", slug), store.get("meta", `spicemixes/${slug}`)]);
if (!item) return Astro.redirect("/admin/spicemixes");

const currentPath = Astro.url.pathname;
---
<html lang="en">
  <head><meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" /><title>{String((item.data as Record<string, unknown>).name ?? slug)} · Edit · Admin</title></head>
  <body>
    <AdminShell currentPath={currentPath} client:load>
      <RecipeForm collection="spicemixes" slug={slug} initialRecipe={item.data as never} initialMeta={metaItem?.data as never} client:load />
    </AdminShell>
  </body>
</html>
