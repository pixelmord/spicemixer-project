---
export const prerender = false;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RecipeMeta from "../../../components/RecipeMeta.astro";
import RelatedList from "../../../components/RelatedList.astro";
import ExternalSourceList from "../../../components/ExternalSourceList.astro";
import { firstImage, keywordList, normalizeInstructions } from "../../../lib/instructions.ts";
import StepImage from "../../../components/StepImage.astro";
import StepsLightbox from "../../../components/StepsLightbox.astro";
import {
  getMeta,
  linkIngredients,
  annotateTextHtml,
  resolveRefs,
} from "../../../lib/recipe-augment.ts";
import { createStore } from "@/lib/content-store.ts";
import type { RecipeCollection } from "@/lib/content-store.ts";

const VALID_COLLECTIONS: RecipeCollection[] = ["recipes", "mixtures"];

const { collection, slug } = Astro.params;
if (!collection || !slug || !VALID_COLLECTIONS.includes(collection as RecipeCollection)) {
  return Astro.redirect("/admin");
}

const store = await createStore();
const item = await store.get(collection as RecipeCollection, slug);
if (!item) return Astro.redirect("/admin");

const data = item.data as Record<string, unknown>;
const image = firstImage(data.image as string | string[] | undefined);
const tags = keywordList(data.keywords as string | string[] | undefined);
const steps = normalizeInstructions(
  data.recipeInstructions as (string | { "@type": "HowToStep"; text: string; name?: string })[],
);

const meta = await getMeta(collection as RecipeCollection, slug);
const linkedIngredients = linkIngredients(
  data.recipeIngredient as string[],
  meta.ingredientLinks,
);
const goesWellWithItems = await resolveRefs(meta.goesWellWith, "");
const lightboxSteps = steps.map((step) => ({
  ...step,
  html: annotateTextHtml(step.text, meta.ingredientLinks, "/ingredients"),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>[Preview] {String(data.name ?? slug)}</title>
  </head>
  <body>
    <div class="bg-amber-50 border-b border-amber-200 px-4 py-2 text-xs text-amber-700 font-medium flex items-center gap-2">
      <span>🔍 Preview mode</span>
      <span class="text-amber-500">·</span>
      <span>This page is not publicly accessible</span>
      <span class="ml-auto">
        <a href={`/admin/${collection}/${slug}/edit`} class="underline hover:no-underline">
          Back to editor
        </a>
      </span>
    </div>

    <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
      {
        image ? (
          <figure class="mb-8 overflow-hidden rounded-3xl">
            <img src={image} alt={String(data.name ?? "")} class="aspect-[16/9] w-full object-cover" />
          </figure>
        ) : (
          <div class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-emerald-50 p-10">
            <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
              {[data.recipeCategory, data.recipeCuisine].filter(Boolean).join(" · ") || "Recipe"}
            </p>
            <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">{String(data.name ?? slug)}</h1>
          </div>
        )
      }

      {
        image && (
          <header class="mb-6">
            <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
              {[data.recipeCategory, data.recipeCuisine].filter(Boolean).join(" · ") || "Recipe"}
            </p>
            <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">
              {String(data.name ?? slug)}
            </h1>
          </header>
        )
      }

      {
        data.description && (
          <p class="mb-6 text-lg italic text-stone-700">{String(data.description)}</p>
        )
      }

      <div class="mb-10 rounded-2xl bg-white p-5 ring-1 ring-stone-200">
        <RecipeMeta
          prepTime={data.prepTime as string | undefined}
          cookTime={data.cookTime as string | undefined}
          totalTime={data.totalTime as string | undefined}
          recipeYield={data.recipeYield as string | number | undefined}
          variant="page"
        />
      </div>

      <section class="mb-10">
        <h2 class="mb-3 font-serif text-2xl text-stone-900">Ingredients</h2>
        <ul class="space-y-1.5">
          {
            linkedIngredients.map(({ text, slug: ingSlug }) => (
              <li class="border-b border-dashed border-stone-200 pb-1.5 text-stone-800">
                {ingSlug ? (
                  <a
                    href={`/ingredients/${ingSlug}/`}
                    class="underline decoration-dotted underline-offset-2 text-amber-700 hover:text-amber-900"
                  >
                    {text}
                  </a>
                ) : (
                  text
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mb-10">
        <h2 class="mb-3 font-serif text-2xl text-stone-900">Instructions</h2>
        <ol class="space-y-4">
          {
            steps.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex-none font-serif text-2xl text-stone-300">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="flex flex-1 items-start gap-3">
                  <p class="flex-1 text-stone-800">
                    {step.name && <strong class="block text-stone-900">{step.name}</strong>}
                    <Fragment
                      set:html={annotateTextHtml(step.text, meta.ingredientLinks, "/ingredients")}
                    />
                  </p>
                  {step.image && <StepImage src={step.image} alt={step.name ?? ""} stepIndex={i} />}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <RelatedList heading="Goes well with" items={goesWellWithItems} />
      <ExternalSourceList heading="External recipes" sources={meta.externalSources} />

      {
        tags.length > 0 && (
          <footer class="border-t border-stone-200 pt-6">
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">{tag}</li>
              ))}
            </ul>
          </footer>
        )
      }
    </main>
    <StepsLightbox steps={lightboxSteps} />
  </body>
</html>
