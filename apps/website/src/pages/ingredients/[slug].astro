---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RelatedList from "../../components/RelatedList.astro";
import { useTranslations, type Lang } from "../../i18n/translations.ts";
import { getUsedIn, getIngredient, getPairings } from "../../lib/recipe-augment.ts";

export async function getStaticPaths() {
  const all = await getCollection("ingredients");
  return all
    .filter((e) => e.id.startsWith("en/"))
    .map((e) => ({
      params: { slug: e.id.replace(/^en\//, "") },
      props: { ingredient: e },
    }));
}

const { ingredient } = Astro.props;
const data = ingredient.data;
const slug = ingredient.id.replace(/^en\//, "");

const t = useTranslations((Astro.currentLocale ?? "en") as Lang);
const locale = Astro.currentLocale ?? "en";
const prefix = locale === "de" ? "/de" : "";

const usedIn = await getUsedIn(slug, prefix);

// Use pairings collection (bidirectional), fall back to legacy inline pairings
const pairingEntities = await getPairings(slug);
const pairingsResolved = pairingEntities.length > 0
  ? await Promise.all(
      pairingEntities.map(async (pairing) => {
        const otherSlug = pairing.ingredients[0] === slug ? pairing.ingredients[1] : pairing.ingredients[0];
        const entry = await getIngredient(otherSlug, locale);
        // Resolve locale-aware description with fallback
        const descriptions = pairing.descriptions ?? {};
        const description = descriptions[locale] ?? descriptions["en"] ?? pairing.description ?? "";
        const isFallback = !descriptions[locale] && (!!descriptions["en"] || !!pairing.description);
        return { slug: otherSlug, name: entry?.data.name ?? otherSlug, description, isFallback };
      })
    )
  : await Promise.all(
      (data.pairings ?? []).map(async ({ slug: pairSlug, note }) => {
        const entry = await getIngredient(pairSlug, locale);
        return { slug: pairSlug, name: entry?.data.name ?? pairSlug, description: note ?? "", isFallback: false };
      })
    );
---

<BaseLayout title={`${data.name} — Spicemixer`} description={data.summary}>
  <main class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-8 flex items-center justify-between text-sm">
      <a
        href={`${prefix}/ingredients/`}
        class="text-stone-500 transition hover:text-stone-900"
      >
        {t("nav.back.ingredients")}
      </a>
      <a
        href={`/admin/ingredients/${slug}/edit`}
        data-admin-link
        class="hidden text-xs text-stone-400 transition hover:text-stone-700"
      >
        Edit
      </a>
    </nav>

    {
      data.image ? (
        <figure class="mb-8 overflow-hidden rounded-3xl">
          <img
            src={data.image}
            alt={data.name}
            class="aspect-[16/9] w-full object-cover"
          />
        </figure>
      ) : (
        <div class="mb-8 rounded-3xl bg-gradient-to-br from-amber-50 via-stone-50 to-rose-50 p-10">
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
            {data.category}
          </p>
          <h1 class="mt-3 font-serif text-5xl leading-tight text-stone-900">
            {data.name}
          </h1>
        </div>
      )
    }

    {
      data.image && (
        <header class="mb-6">
          <p class="text-[10px] font-semibold uppercase tracking-[0.3em] text-stone-500">
            {data.category}
          </p>
          <h1 class="mt-2 font-serif text-5xl leading-tight text-stone-900">
            {data.name}
          </h1>
        </header>
      )
    }

    {
      data.summary && (
        <p class="mb-6 text-lg italic text-stone-700">{data.summary}</p>
      )
    }

    {
      (data.origin.length > 0 || data.flavorNotes.length > 0) && (
        <div class="mb-10 rounded-2xl bg-white p-5 ring-1 ring-stone-200">
          <dl class="flex flex-wrap gap-x-8 gap-y-3 text-sm">
            {data.origin.length > 0 && (
              <div>
                <dt class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">
                  {t("meta.origin")}
                </dt>
                <dd class="mt-0.5 text-stone-700">{data.origin.join(", ")}</dd>
              </div>
            )}
            {data.flavorNotes.length > 0 && (
              <div>
                <dt class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">
                  {t("meta.flavour")}
                </dt>
                <dd class="mt-0.5 text-stone-700">
                  {data.flavorNotes.join(", ")}
                </dd>
              </div>
            )}
          </dl>
        </div>
      )
    }

    {
      data.description && (
        <section class="mb-10">
          <p class="leading-relaxed text-stone-800">{data.description}</p>
        </section>
      )
    }

    {
      pairingsResolved.length > 0 && (
        <section class="mb-10">
          <h2 class="mb-4 font-serif text-2xl text-stone-900">
            {t("section.pairings")}
          </h2>
          <ul class="space-y-3">
            {pairingsResolved.map(({ slug: pairSlug, name, description, isFallback }) => (
              <li class="rounded-xl bg-white p-4 ring-1 ring-stone-200">
                <a
                  href={`${prefix}/ingredients/${pairSlug}/`}
                  class="font-medium text-amber-700 underline decoration-dotted underline-offset-2 hover:text-amber-900"
                >
                  {name}
                </a>
                {description && (
                  <p class={`mt-1 text-sm ${isFallback ? "text-stone-400 italic" : "text-stone-600"}`}>
                    {description}
                    {isFallback && <span class="ml-1 text-xs not-italic">(EN)</span>}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RelatedList heading={t("section.usedIn")} items={usedIn} />
  </main>
</BaseLayout>
