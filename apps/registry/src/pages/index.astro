---
import "../styles/global.css";

const REGISTRY_BASE = "https://spicemixer.app/registry";

const stackAssumptions = [
  { label: "React 19", detail: "hooks, JSX, concurrent features" },
  { label: "Tailwind v4", detail: "utility classes, no config file" },
  { label: "shadcn-ui (base-ui flavour)", detail: "headless primitives at @/components/ui/*" },
  { label: "lucide-react", detail: "icon library" },
  { label: "sonner", detail: "toasts — used sparingly" },
  { label: "cn() from @/lib/utils", detail: "Tailwind class merging" },
];

const primitives = [
  { name: "confidence-badge", title: "ConfidenceBadge", description: "Colored badge for high / medium / low confidence variants." },
  { name: "accept-reject-buttons", title: "AcceptRejectButtons", description: "Check/reject button pair for accepting or dismissing AI suggestions." },
  { name: "text-suggestion-row", title: "TextSuggestionRow", description: "Text field row renderer with read-only and interactive (accept/reject) modes." },
  { name: "tags-suggestion-row", title: "TagsSuggestionRow", description: "Tag chips renderer for tag-list suggestions." },
  { name: "enum-suggestion-row", title: "EnumSuggestionRow", description: "Enum picker renderer for single-value suggestions." },
  { name: "multi-enum-suggestion-row", title: "MultiEnumSuggestionRow", description: "Multi-enum renderer for multi-select suggestions." },
  { name: "date-suggestion-row", title: "DateSuggestionRow", description: "Date renderer for ISO date string suggestions." },
  { name: "preset-picker", title: "PresetPicker", description: "Reads contract.presets and emits the selected preset id." },
  { name: "user-prompt-field", title: "UserPromptField", description: "Labeled textarea for free-text instruction amendments." },
  { name: "diff-preview", title: "DiffPreview", description: "Side-by-side before/after diff for a single field's text." },
  { name: "write-policy-picker", title: "WritePolicyPicker", description: "Radio picker for preserve / replace / fill-if-empty / merge policies." },
  { name: "capability-label", title: "CapabilityLabel", description: "In-flight action label (\"Proposing tags…\") with animated spinner." },
  { name: "auto-apply-badge", title: "AutoApplyBadge", description: "Inline badge for auto-applied fields; carries hash, summary, and revert affordance." },
  { name: "suggestion-trace-info", title: "SuggestionTraceInfo", description: "Info popover showing TraceSummary scalars only — no token counts, cost, system prompt, or response body (ADR 0011)." },
  { name: "file-input", title: "FileInput", description: "File upload source with drag-area trigger." },
  { name: "text-area-source", title: "TextAreaSource", description: "Textarea source for pasting raw text content." },
  { name: "prompt-input-source", title: "PromptInputSource", description: "Textarea for entering a free-form AI generation prompt." },
  { name: "url-input", title: "UrlInput", description: "URL source input field." },
  { name: "tag-chips-input", title: "TagChipsInput", description: "Inline tag chip editor with Enter/comma confirmation." },
];

const blocks = [
  { name: "ai-suggestions-indicator", title: "AiSuggestionsIndicator", description: "Small widget showing idle / running / has-suggestions / mixed states with a counter (N auto-applied · M to review) and an Options affordance." },
  { name: "suggestions-options", title: "SuggestionsOptions", description: "Options panel composing PresetPicker, UserPromptField, and WritePolicyPicker with a Run button. Reads run state from SuggestionFlowProvider context." },
  { name: "inline-field-suggestion", title: "InlineFieldSuggestion", description: "Per-field AI suggestion block mounting adjacent to a form input. Dispatches by field kind via renderers prop. Ships defaultRenderers for text, array, enum, multi-enum, date." },
  { name: "file-text-prompt-source-picker", title: "FileTextPromptSourcePicker", description: "Tabbed three-way source input (File / Text / Prompt) emitting a controlled { kind, …payload }. Used as the source-selection panel inside IngestDialog." },
  { name: "ingest-dialog", title: "IngestDialog", description: "Modal for cold-fill operations: bundles FileTextPromptSourcePicker + options (preset, user-prompt, write-policy) + post-run inline-suggestion review. Consumer wires onRun to their fill action." },
];

const hooks = [
  { name: "use-ai-suggestions", title: "useAiSuggestions", description: "Headless orchestration hook owning run state, per-field accept/reject/revert flows, viewed-field tracking, and accept-all gating." },
  { name: "suggestion-flow-provider", title: "SuggestionFlowProvider", description: "Context provider hosting useAiSuggestions return for deep forms, with useSuggestionFlowContext() reader." },
];

const legacySmoke = [
  { name: "__hello-world__", title: "Hello World", description: "Trivial smoke-test component for CLI verification." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pixelmord/ui-registry</title>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 font-sans">
    <div class="mx-auto max-w-3xl px-6 py-16 space-y-12">

      <header class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">@pixelmord/ui-registry</h1>
        <p class="text-stone-600 text-lg">
          A shadcn-style code registry for AI-suggestion UI primitives and blocks.
          Components paste into your repo via the shadcn CLI — you own and modify them freely.
        </p>
      </header>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Usage</h2>
        <p class="text-stone-600">
          Add a registry item to your project with the shadcn CLI:
        </p>
        <pre class="bg-stone-900 text-stone-100 rounded-lg p-4 overflow-x-auto text-sm"><code>pnpm dlx shadcn@latest add {REGISTRY_BASE}/r/confidence-badge</code></pre>
        <p class="text-stone-500 text-sm">
          Replace <code class="bg-stone-100 px-1 rounded">confidence-badge</code> with the item name.
          The CLI fetches the item JSON and pastes the source files into your project.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Stack assumptions</h2>
        <p class="text-stone-600">
          Every registry item assumes the following stack in the consuming project.
          Items import <strong>types only</strong> from <code class="bg-stone-100 px-1 rounded">@pixelmord/content-ai-core</code> —
          zero runtime imports from lifted packages.
        </p>
        <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
          {stackAssumptions.map(({ label, detail }) => (
            <li class="flex items-start gap-4 px-4 py-3">
              <span class="font-mono text-sm font-medium text-amber-700 min-w-[200px]">{label}</span>
              <span class="text-stone-500 text-sm">{detail}</span>
            </li>
          ))}
        </ul>
        <p class="text-stone-500 text-sm">
          Registry items do <strong>not</strong> assume a specific RPC layer, form library, or
          persistence backend. Runner functions are injected via props; form integration is via
          controlled <code class="bg-stone-100 px-1 rounded">currentValue</code> /
          <code class="bg-stone-100 px-1 rounded">onApply</code> props.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Primitives (PRD 9.3)</h2>
        <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
          {primitives.map(({ name, title, description }) => (
            <li class="px-4 py-3 space-y-1">
              <div class="flex items-center gap-3">
                <code class="font-mono text-sm font-medium">{name}</code>
                <span class="text-stone-400 text-xs">{title}</span>
              </div>
              <p class="text-stone-500 text-sm">{description}</p>
              <pre class="mt-2 bg-stone-50 text-stone-700 rounded p-2 text-xs overflow-x-auto"><code>pnpm dlx shadcn@latest add {REGISTRY_BASE}/r/{name}</code></pre>
            </li>
          ))}
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Blocks (PRD 9.4)</h2>
        <p class="text-stone-600 text-sm">
          Larger composed components — paste one to get the full feature.
          Each block reads run state from <code class="bg-stone-100 px-1 rounded">SuggestionFlowProvider</code> context.
        </p>
        <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
          {blocks.map(({ name, title, description }) => (
            <li class="px-4 py-3 space-y-1">
              <div class="flex items-center gap-3">
                <code class="font-mono text-sm font-medium">{name}</code>
                <span class="text-stone-400 text-xs">{title}</span>
              </div>
              <p class="text-stone-500 text-sm">{description}</p>
              <pre class="mt-2 bg-stone-50 text-stone-700 rounded p-2 text-xs overflow-x-auto"><code>pnpm dlx shadcn@latest add {REGISTRY_BASE}/r/{name}</code></pre>
            </li>
          ))}
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Hooks (PRD 9.5)</h2>
        <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
          {hooks.map(({ name, title, description }) => (
            <li class="px-4 py-3 space-y-1">
              <div class="flex items-center gap-3">
                <code class="font-mono text-sm font-medium">{name}</code>
                <span class="text-stone-400 text-xs">{title}</span>
              </div>
              <p class="text-stone-500 text-sm">{description}</p>
              <pre class="mt-2 bg-stone-50 text-stone-700 rounded p-2 text-xs overflow-x-auto"><code>pnpm dlx shadcn@latest add {REGISTRY_BASE}/r/{name}</code></pre>
            </li>
          ))}
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Utilities</h2>
        <ul class="divide-y divide-stone-200 rounded-lg border border-stone-200 bg-white">
          {legacySmoke.map(({ name, title, description }) => (
            <li class="px-4 py-3 space-y-1">
              <div class="flex items-center gap-3">
                <code class="font-mono text-sm font-medium">{name}</code>
                <span class="text-stone-400 text-xs">{title}</span>
              </div>
              <p class="text-stone-500 text-sm">{description}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-xl font-semibold">Registry manifest</h2>
        <p class="text-stone-600">
          The full registry manifest is available at:
        </p>
        <pre class="bg-stone-900 text-stone-100 rounded-lg p-4 overflow-x-auto text-sm"><code>{REGISTRY_BASE}/registry.json</code></pre>
      </section>

    </div>
  </body>
</html>
